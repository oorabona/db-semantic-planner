{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"pull-request-title-pattern": "chore: release ${component} ${version}",
	"separate-pull-requests": false,
	"include-component-in-tag": true,
	"plugins": [
		{ "type": "node-workspace" },
		{ "type": "sentence-case" }
	],
	"packages": {
		"packages/types":         { "package-name": "@dbsp/types" },
		"packages/nql":           { "package-name": "@dbsp/nql" },
		"packages/core":          { "package-name": "@dbsp/core" },
		"packages/adapter-pgsql": { "package-name": "@dbsp/adapter-pgsql" },
		"packages/cli":           { "package-name": "@dbsp/cli" },
		"packages/mcp-server":    { "package-name": "@dbsp/mcp-server" }
	}
}
