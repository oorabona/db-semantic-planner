{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"pull-request-title-pattern": "chore(release): release ${component} ${version}",
	"group-pull-request-title-pattern": "chore(release): release ${branch}",
	"separate-pull-requests": false,
	"include-component-in-tag": true,
	"plugins": [{ "type": "node-workspace" }, { "type": "sentence-case" }],
	"packages": {
		"packages/types": { "package-name": "@dbsp/types" },
		"packages/nql": { "package-name": "@dbsp/nql" },
		"packages/core": { "package-name": "@dbsp/core" },
		"packages/adapter-pgsql": {
			"package-name": "@dbsp/adapter-pgsql",
			"release-as": "3.2.2"
		},
		"packages/cli": { "package-name": "@dbsp/cli", "release-as": "2.1.3" },
		"packages/mcp-server": {
			"package-name": "@dbsp/mcp-server",
			"release-as": "2.0.4"
		}
	}
}
