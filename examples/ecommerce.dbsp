# Chapter 5: E-Commerce Schema
# QUICKSTART.md - Multiple FK relations, complex hierarchies, window functions, advanced aggregates
#
# Usage:
#   pnpm dbsp repl --schema ./examples/ecommerce.schema.ts \
#     --db postgresql://postgres:demo@localhost:5432/demo \
#     --input ./examples/ecommerce.dbsp
#
# NQL v2 Syntax: uses pipes (|) between operators

# =============================================================================
# Setup: Create isolated schema and load data
# =============================================================================

# Create schema (! prefix = raw SQL in natural mode)
!CREATE SCHEMA IF NOT EXISTS ch5_ecommerce;

# Set schema context for subsequent operations
.use ch5_ecommerce

# Import DDL (creates tables in schema)
.import examples/ecommerce.ddl.sql

# Import seed data
.import examples/ecommerce.seed.sql

# =============================================================================
# 5.3 Explore Data
# =============================================================================
.tables
categories
products | where active = true | limit 5
customers
orders

# =============================================================================
# 5.4 Complex Relations
# =============================================================================
categories | with products | where active = true
products | with variants | limit 3
customers | with orders | with orderItems

# =============================================================================
# 5.5 Aggregates on E-Commerce Data
# =============================================================================
orders | group by status | select sum(total)
orders | group by customerId | select count(*)
orders | select avg(total)
products | group by active | select count(*)

# =============================================================================
# 5.6 Window Functions
# =============================================================================
products | select *, rank() over (partition by categoryId order by price desc) as priceRank
orders | select orderNumber, total, sum(total) over (order by createdAt) as runningTotal

# =============================================================================
# 5.7 Mutations (NQL v2: SQL-like syntax)
# =============================================================================

# Insert a new category
insert into categories set name = "Accessories", slug = "accessories"

# Insert a new customer
insert into customers set name = "John Doe", email = "john@example.com"

# Update product price
update products set price = 29.99 where sku = "WIDGET-001"

# Deactivate out-of-stock products
update products set active = false where id = 5

# Delete cancelled orders
delete from orders where status = "cancelled"

# Upsert product - insert or update on SKU conflict
upsert into products on sku set name = "New Widget", sku = "WIDGET-NEW", price = 19.99, categoryId = 1, active = true
