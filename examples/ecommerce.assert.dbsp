# ─────────────────────────────────────────
--- query: 14
success: true
sql.equals: select count(*) as "count_result" from "ch5_ecommerce"."orders" as "_orders" group by "_orders"."customer_id"
sql.equals: select count(*) as "count_result" from "ch5_ecommerce"."orders" as "_orders" group by "_orders"."customer_id"
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 15 orders | select avg(total)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 15
success: true
sql.equals: select avg("_orders"."total") as "avg_result" from "ch5_ecommerce"."orders" as "_orders"
