# ─────────────────────────────────────────
# Query 18 orders | select orderNumber, total, sum(total) over (order by createdAt) as runningTotal
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 18
success: true
sql.equals: SELECT orders.order_number, orders.total, sum(orders.total) OVER (ORDER BY orders.created_at ASC) AS "runningTotal" FROM ch5_ecommerce.orders
db.output:
| order_number | total   | runningTotal |
|--------------|---------|--------------|
| ORD-2024-001 | 1499.98 | 1499.98       |
| ORD-2024-005 | 179.97  | 1679.95       |
| ORD-2024-002 | 349.99  | 2029.94       |
| ORD-2024-003 | 94.98   | 2124.92       |
| ORD-2024-004 | 999.99  | 3124.91       |
| ORD-2024-006 | 1099.98 | 4224.89       |
