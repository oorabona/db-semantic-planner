# Assertions for ecommerce.dbsp
# Validates output from ecommerce schema queries

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS ch5_ecommerce CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1 !CREATE SCHEMA IF NOT EXISTS ch5_ecommerce;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 2 .use ch5_ecommerce
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: ch5_ecommerce

# ─────────────────────────────────────────
# Query 3 .import examples/ecommerce.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4 .import examples/ecommerce.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5 .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (7)
output.contains: categories
output.contains: products
output.contains: variants
output.contains: customers
output.contains: addresses
output.contains: orders
output.contains: orderItems

# ─────────────────────────────────────────
# Query 6 categories
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: from "ch5_ecommerce"."categories"
db.rows.equals: 20
db.output.contains: Electronics
db.output.contains: Clothing
db.output.contains: Books

# ─────────────────────────────────────────
# Query 7 products | where active = true | limit 5
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "ch5_ecommerce"."products"
sql.contains: where "_products"."active" = $1
sql.contains: limit
params.equals: [true, 5]
db.rows.equals: 5
db.output.contains: ProBook 15
db.output.contains: SmartPhone X

# ─────────────────────────────────────────
# Query 8 customers
# ─────────────────────────────────────────
--- query: 8
success: true
sql.contains: from "ch5_ecommerce"."customers"
db.rows.equals: 5
db.output.contains: Alice
db.output.contains: Bob

# ─────────────────────────────────────────
# Query 9 orders
# ─────────────────────────────────────────
--- query: 9
success: true
sql.contains: from "ch5_ecommerce"."orders"
db.rows.equals: 7
db.output.contains: ORD-2024-001
db.output.contains: delivered
db.output.contains: shipped

# ─────────────────────────────────────────
# Query 10 categories | select *, products.*
# NQL v2.1: Filtered includes not yet supported in NQL syntax
# ─────────────────────────────────────────
--- query: 10
success: true
sql.contains: from "ch5_ecommerce"."categories"
sql.contains: left join "ch5_ecommerce"."products"
db.rows.equals: 24

# ─────────────────────────────────────────
# Query 11 products | select *, variants.* | limit 3
# ─────────────────────────────────────────
--- query: 11
success: true
sql.contains: left join "ch5_ecommerce"."variants"
sql.contains: on "_products"."id" = "_variants"."product_id"
sql.contains: limit
params.equals: [3]
db.rows.equals: 3
output.contains: variants.id
output.contains: variants.sku

# ─────────────────────────────────────────
# Query 12 customers | select *, orders.*
# NQL v2.1: Deep nesting (orders.orderItems) requires ORM API
# ─────────────────────────────────────────
--- query: 12
success: true
sql.contains: from "ch5_ecommerce"."customers"
db.rows.equals: 7

# ─────────────────────────────────────────
# Query 13 orders | group by status | select sum(total)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 13
success: true
sql.contains: group by "_orders"."status"
sql.contains: sum
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 14 orders | group by customerId | select count(*)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 14
success: true
sql.contains: group by "_orders"."customer_id"
sql.contains: count
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 15 orders | select avg(total)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 15
success: true
sql.contains: avg
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 16 products | group by active | select count(*)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 16
success: true
sql.contains: group by "_products"."active"
sql.contains: count
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 17 products | select *, rank() over (partition by categoryId order by price desc) as priceRank
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 17
success: true
sql.contains: RANK() OVER
sql.contains: PARTITION BY
sql.contains: ORDER BY

# ─────────────────────────────────────────
# Query 18 orders | select orderNumber, total, sum(total) over (order by createdAt) as runningTotal
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 18
success: true
sql.contains: SUM
sql.contains: OVER
sql.contains: ORDER BY

# ─────────────────────────────────────────
# Query 19 insert into categories set name = 'Accessories', slug = 'accessories'
# ─────────────────────────────────────────
--- query: 19
success: true
sql.contains: insert into "ch5_ecommerce"."categories"
sql.contains: ("name", "slug") values ($1, $2)
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 20 insert into customers set firstName = 'John', lastName = 'Doe', email = 'john@example.com'
# ─────────────────────────────────────────
--- query: 20
success: true
sql.contains: insert into "ch5_ecommerce"."customers"
sql.contains: ("first_name", "last_name", "email") values ($1, $2, $3)
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 21 update products set price = 29.99 where sku = 'WIDGET-001'
# NOTE: WIDGET-001 doesn't exist in seed data, so 0 rows affected
# ─────────────────────────────────────────
--- query: 21
success: true
sql.contains: update "ch5_ecommerce"."products"
sql.contains: set "price" = $1
sql.contains: where "sku" = $2
db.rows.equals: 0

# ─────────────────────────────────────────
# Query 22 update products set active = false where id = 5
# ─────────────────────────────────────────
--- query: 22
success: true
sql.contains: update "ch5_ecommerce"."products"
sql.contains: set "active" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 23 delete from orders where status = 'cancelled'
# NOTE: Seed data contains one cancelled order
# ─────────────────────────────────────────
--- query: 23
success: true
sql.contains: delete from "ch5_ecommerce"."orders"
sql.contains: where "status" = $1
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 24 upsert into products on sku set name = 'New Widget', sku = 'WIDGET-NEW', price = 19.99, categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 24
success: true
sql.contains: insert into "ch5_ecommerce"."products"
sql.contains: on conflict ("sku") do update
db.rows.equals: 1
