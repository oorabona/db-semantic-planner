# ─────────────────────────────────────────
# Query 10 categories | select *, products.* | flat
# flat: simple JOIN (no per-include limit)
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: SELECT categories.*, products.* FROM ch5_ecommerce.categories LEFT JOIN ch5_ecommerce.products AS products ON categories.id = products.category_id

# ─────────────────────────────────────────
# Query 11 products | select *, variants.* | flat | limit 3
# flat: simple JOIN (global LIMIT, not per-include limit)
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: SELECT products.*, variants.* FROM ch5_ecommerce.products LEFT JOIN ch5_ecommerce.variants AS variants ON products.id = variants.product_id LIMIT 3
params.equals: []

# ─────────────────────────────────────────
# Query 12 customers | select *, orders.*
# NQL v2.1: Deep nesting (orders.orderItems) requires ORM API
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT customers.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM ch5_ecommerce.orders AS __t__ WHERE __t__.customer_id = customers.id), '[]'::json) AS orders_json FROM ch5_ecommerce.customers
db.rows.equals: 5
db.output:
| id | email             | first_name | last_name | phone       | created_at               | orders_json                                                                                                                                                                                                                                                                                                                                                                                               |
