# ─────────────────────────────────────────
# Query 17 products | select *, rank() over (partition by categoryId order by price desc) as priceRank
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 17
success: true
sql.equals: SELECT products.*, rank() OVER ( PARTITION BY products.category_id ORDER BY products.price DESC ) AS "priceRank" FROM ch5_ecommerce.products
