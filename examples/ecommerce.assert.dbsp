# ─────────────────────────────────────────
# Query 16 products | group by active | select count(*)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 16
success: true
sql.equals: select count(*) as "count_result" from "ch5_ecommerce"."products" as "_products" group by "_products"."active"
sql.equals: select count(*) as "count_result" from "ch5_ecommerce"."products" as "_products" group by "_products"."active"
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 17 products | select *, rank() over (partition by categoryId order by price desc) as priceRank
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 17
success: true
sql.equals: select "_products".*, RANK() OVER (PARTITION BY "_products"."category_id" ORDER BY "_products"."price" DESC) as "price_rank" from "ch5_ecommerce"."products" as "_products"
sql.equals: select "_products".*, RANK() OVER (PARTITION BY "_products"."category_id" ORDER BY "_products"."price" DESC) as "price_rank" from "ch5_ecommerce"."products" as "_products"
sql.equals: select "_products".*, RANK() OVER (PARTITION BY "_products"."category_id" ORDER BY "_products"."price" DESC) as "price_rank" from "ch5_ecommerce"."products" as "_products"

# ─────────────────────────────────────────
# Query 18 orders | select orderNumber, total, sum(total) over (order by createdAt) as runningTotal
# BUG FIXED: Window functions now work in NQL parser
# ─────────────────────────────────────────
--- query: 18
success: true
sql.equals: select "_orders"."order_number", "_orders"."total", SUM("_orders"."total") OVER (ORDER BY "_orders"."created_at" ASC) as "running_total" from "ch5_ecommerce"."orders" as "_orders"
sql.equals: select "_orders"."order_number", "_orders"."total", SUM("_orders"."total") OVER (ORDER BY "_orders"."created_at" ASC) as "running_total" from "ch5_ecommerce"."orders" as "_orders"
sql.equals: select "_orders"."order_number", "_orders"."total", SUM("_orders"."total") OVER (ORDER BY "_orders"."created_at" ASC) as "running_total" from "ch5_ecommerce"."orders" as "_orders"

