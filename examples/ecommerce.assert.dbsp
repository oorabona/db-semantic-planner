# Assertions for ecommerce.dbsp
# Validates output from ecommerce schema queries

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS ch5_ecommerce CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1 !CREATE SCHEMA IF NOT EXISTS ch5_ecommerce;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 2 .use ch5_ecommerce
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: ch5_ecommerce

# ─────────────────────────────────────────
# Query 3 .import examples/ecommerce.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4 .import examples/ecommerce.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5 .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (7)
output.contains: categories
output.contains: products
output.contains: variants
output.contains: customers
output.contains: addresses
output.contains: orders
output.contains: orderItems

# ─────────────────────────────────────────
# Query 6 categories
# ─────────────────────────────────────────
--- query: 6
success: true
sql.equals: select "_categories".* from "ch5_ecommerce"."categories" as "_categories"
db.rows.equals: 20
db.output.contains: Electronics
db.output.contains: Clothing
db.output.contains: Books

# ─────────────────────────────────────────
# Query 7 products | where active = true | limit 5
# ─────────────────────────────────────────
--- query: 7
success: true
sql.equals: select "_products".* from "ch5_ecommerce"."products" as "_products" where "_products"."active" = $1 limit $2
sql.equals: select "_products".* from "ch5_ecommerce"."products" as "_products" where "_products"."active" = $1 limit $2
sql.equals: select "_products".* from "ch5_ecommerce"."products" as "_products" where "_products"."active" = $1 limit $2
params.equals: [true, 5]
db.rows.equals: 5
db.output.contains: ProBook 15
db.output.contains: SmartPhone X

# ─────────────────────────────────────────
# Query 8 customers
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: select "_customers".* from "ch5_ecommerce"."customers" as "_customers"
db.rows.equals: 5
db.output.contains: Alice
db.output.contains: Bob

# ─────────────────────────────────────────
# Query 9 orders
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: select "_orders".* from "ch5_ecommerce"."orders" as "_orders"
db.rows.equals: 7
db.output.contains: ORD-2024-001
db.output.contains: delivered
db.output.contains: shipped

# ─────────────────────────────────────────
# Query 10 categories | select *, products.*
# NQL v2.1: Filtered includes not yet supported in NQL syntax
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: select "_categories".*, "_products".*, "_products"."id" as "products.id", "_products"."sku" as "products.sku", "_products"."name" as "products.name", "_products"."description" as "products.description", "_products"."price" as "products.price", "_products"."stock" as "products.stock", "_products"."category_id" as "products.category_id", "_products"."active" as "products.active", "_products"."created_at" as "products.created_at" from "ch5_ecommerce"."categories" as "_categories" left join "ch5_ecommerce"."products" as "_products" on "_categories"."id" = "_products"."category_id"
sql.equals: select "_categories".*, "_products".*, "_products"."id" as "products.id", "_products"."sku" as "products.sku", "_products"."name" as "products.name", "_products"."description" as "products.description", "_products"."price" as "products.price", "_products"."stock" as "products.stock", "_products"."category_id" as "products.category_id", "_products"."active" as "products.active", "_products"."created_at" as "products.created_at" from "ch5_ecommerce"."categories" as "_categories" left join "ch5_ecommerce"."products" as "_products" on "_categories"."id" = "_products"."category_id"
db.rows.equals: 24

# ─────────────────────────────────────────
# Query 11 products | select *, variants.* | limit 3
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: select "_products".*, "_variants".*, "_variants"."id" as "variants.id", "_variants"."product_id" as "variants.product_id", "_variants"."sku" as "variants.sku", "_variants"."name" as "variants.name", "_variants"."price_modifier" as "variants.price_modifier", "_variants"."stock" as "variants.stock" from "ch5_ecommerce"."products" as "_products" left join "ch5_ecommerce"."variants" as "_variants" on "_products"."id" = "_variants"."product_id" limit $1
sql.equals: select "_products".*, "_variants".*, "_variants"."id" as "variants.id", "_variants"."product_id" as "variants.product_id", "_variants"."sku" as "variants.sku", "_variants"."name" as "variants.name", "_variants"."price_modifier" as "variants.price_modifier", "_variants"."stock" as "variants.stock" from "ch5_ecommerce"."products" as "_products" left join "ch5_ecommerce"."variants" as "_variants" on "_products"."id" = "_variants"."product_id" limit $1
sql.equals: select "_products".*, "_variants".*, "_variants"."id" as "variants.id", "_variants"."product_id" as "variants.product_id", "_variants"."sku" as "variants.sku", "_variants"."name" as "variants.name", "_variants"."price_modifier" as "variants.price_modifier", "_variants"."stock" as "variants.stock" from "ch5_ecommerce"."products" as "_products" left join "ch5_ecommerce"."variants" as "_variants" on "_products"."id" = "_variants"."product_id" limit $1
params.equals: [3]
db.rows.equals: 3
output.contains: variants.id
output.contains: variants.sku

# ─────────────────────────────────────────
# Query 12 customers | select *, orders.*
# NQL v2.1: Deep nesting (orders.orderItems) requires ORM API
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: select "_customers".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch5_ecommerce"."orders" AS __t__ WHERE "__t__"."customer_id" = "_customers"."id"), '[]'::json) as "orders_json" from "ch5_ecommerce"."customers" as "_customers"
db.rows.equals: 7

# ─────────────────────────────────────────
# Query 13 orders | group by status | select sum(total)
# BUG FIXED: Aggregate functions now work
# ─────────────────────────────────────────
--- query: 13
success: true
sql.equals: select sum("_orders"."total") as "sum_result" from "ch5_ecommerce"."orders" as "_orders" group by "_orders"."status"
sql.equals: select sum("_orders"."total") as "sum_result" from "ch5_ecommerce"."orders" as "_orders" group by "_orders"."status"
db.rows.equals: 5

# ─────────────────────────────────────────
