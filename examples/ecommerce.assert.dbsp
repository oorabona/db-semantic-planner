# ─────────────────────────────────────────
# Query 19 insert into categories set name = 'Accessories', slug = 'accessories'
# ─────────────────────────────────────────
--- query: 19
success: true
sql.equals: INSERT INTO ch5_ecommerce.categories ( name, slug ) VALUES ( $1, $2 )
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 20 insert into customers set firstName = 'John', lastName = 'Doe', email = 'john@example.com'
# ─────────────────────────────────────────
--- query: 20
success: true
sql.equals: INSERT INTO ch5_ecommerce.customers ( first_name, last_name, email ) VALUES ( $1, $2, $3 )
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 21 update products set price = 29.99 where sku = 'WIDGET-001'
# NOTE: WIDGET-001 doesn't exist in seed data, so 0 rows affected
# ─────────────────────────────────────────
--- query: 21
success: true
sql.equals: UPDATE ch5_ecommerce.products SET price = $1 WHERE products.sku = $2
db.rows.equals: 0

# ─────────────────────────────────────────
# Query 22 update products set active = false where id = 5
# ─────────────────────────────────────────
--- query: 22
success: true
sql.equals: UPDATE ch5_ecommerce.products SET active = $1 WHERE products.id = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 23 delete from orders where status = 'cancelled'
# NOTE: Seed data contains one cancelled order
# ─────────────────────────────────────────
--- query: 23
success: true
sql.equals: DELETE FROM ch5_ecommerce.orders WHERE orders.status = $1
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 24 upsert into products on sku set name = 'New Widget', sku = 'WIDGET-NEW', price = 19.99, categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 24
success: true
sql.equals: INSERT INTO ch5_ecommerce.products ( name, sku, price, category_id, active ) VALUES ( $1, $2, $3, $4, $5 ) ON CONFLICT (sku) DO UPDATE SET name = excluded.name, sku = excluded.sku, price = excluded.price, category_id = excluded.category_id, active = excluded.active
db.rows.equals: 1
