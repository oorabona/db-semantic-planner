# ─────────────────────────────────────────
# Query 24 upsert into products on sku set name = 'New Widget', sku = 'WIDGET-NEW', price = 19.99, categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 24
success: true
sql.equals: insert into "ch5_ecommerce"."products" ("name", "sku", "price", "category_id", "active") values ($1, $2, $3, $4, $5) on conflict ("sku") do update set "name" = $6, "sku" = $7, "price" = $8, "category_id" = $9, "active" = $10
sql.equals: insert into "ch5_ecommerce"."products" ("name", "sku", "price", "category_id", "active") values ($1, $2, $3, $4, $5) on conflict ("sku") do update set "name" = $6, "sku" = $7, "price" = $8, "category_id" = $9, "active" = $10
db.rows.equals: 1
