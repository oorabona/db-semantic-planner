# Assertions for ecommerce.dbsp
# Validates output from ecommerce schema queries

# ─────────────────────────────────────────
# Query 0: !CREATE SCHEMA IF NOT EXISTS ch5_ecommerce;
# ─────────────────────────────────────────
--- query: 0
success: true
output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1: .use ch5_ecommerce
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Using schema: ch5_ecommerce

# ─────────────────────────────────────────
# Query 2: .import examples/ecommerce.ddl.sql
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Imported

# ─────────────────────────────────────────
# Query 3: .import examples/ecommerce.seed.sql
# ─────────────────────────────────────────
--- query: 3
success: true
output.contains: Imported

# ─────────────────────────────────────────
# Query 4: .tables
# ─────────────────────────────────────────
--- query: 4
success: true
output.contains: Tables (7)
output.contains: categories
output.contains: products
output.contains: variants
output.contains: customers
output.contains: addresses
output.contains: orders
output.contains: orderItems

# ─────────────────────────────────────────
# Query 5: categories
# ─────────────────────────────────────────
--- query: 5
success: true
sql.contains: from "ch5_ecommerce"."categories"
output.contains: Rows: 20
output.contains: Electronics
output.contains: Clothing
output.contains: Books

# ─────────────────────────────────────────
# Query 6: products | where active = true | limit 5
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: from "ch5_ecommerce"."products"
sql.contains: where "t0"."active" = $1
sql.contains: limit
params.equals: [true, 5]
output.contains: Rows: 5
output.contains: ProBook 15
output.contains: SmartPhone X

# ─────────────────────────────────────────
# Query 7: customers
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "ch5_ecommerce"."customers"
output.contains: Rows: 5
output.contains: Alice
output.contains: Bob

# ─────────────────────────────────────────
# Query 8: orders
# ─────────────────────────────────────────
--- query: 8
success: true
sql.contains: from "ch5_ecommerce"."orders"
output.contains: Rows: 7
output.contains: ORD-2024-001
output.contains: delivered
output.contains: shipped

# ─────────────────────────────────────────
# Query 9: categories | with products | where active = true
# KNOWN BUG: Nested include with where clause fails (same as blog-extended)
# ─────────────────────────────────────────
--- query: 9
success: false
output.contains: Error
output.contains: column t0.active does not exist

# ─────────────────────────────────────────
# Query 10: products | with variants | limit 3
# ─────────────────────────────────────────
--- query: 10
success: true
sql.contains: left join "ch5_ecommerce"."variants"
sql.contains: on "t1"."product_id" = "t0"."id"
sql.contains: limit
params.equals: [3]
output.contains: Rows: 3
output.contains: variants.id
output.contains: variants.sku

# ─────────────────────────────────────────
# Query 11: customers | with orders | with orderItems
# NOTE: Multiple includes don't chain - only first is applied
# ─────────────────────────────────────────
--- query: 11
success: true
sql.contains: from "ch5_ecommerce"."customers"
output.contains: Rows: 5

# ─────────────────────────────────────────
# Query 12: orders | group by status | select sum(total)
# KNOWN BUG: Aggregate functions not yet implemented in NQL executor
# ─────────────────────────────────────────
--- query: 12
success: false
output.contains: Error
output.contains: Cannot read properties of undefined

# ─────────────────────────────────────────
# Query 13: orders | group by customerId | select count(*)
# KNOWN BUG: Aggregate functions not yet implemented in NQL executor
# ─────────────────────────────────────────
--- query: 13
success: false
output.contains: Error
output.contains: Cannot read properties of undefined

# ─────────────────────────────────────────
# Query 14: orders | select avg(total)
# KNOWN BUG: Aggregate functions not yet implemented in NQL executor
# ─────────────────────────────────────────
--- query: 14
success: false
output.contains: Error
output.contains: Cannot read properties of undefined

# ─────────────────────────────────────────
# Query 15: products | group by active | select count(*)
# KNOWN BUG: Aggregate functions not yet implemented in NQL executor
# ─────────────────────────────────────────
--- query: 15
success: false
output.contains: Error
output.contains: Cannot read properties of undefined

# ─────────────────────────────────────────
# Query 16: products | select *, rank() over (partition by categoryId order by price desc) as priceRank
# KNOWN BUG: Window functions not yet supported in NQL parser
# ─────────────────────────────────────────
--- query: 16
success: false
output.contains: Error
output.contains: NQL parse error

# ─────────────────────────────────────────
# Query 17: orders | select orderNumber, total, sum(total) over (order by createdAt) as runningTotal
# KNOWN BUG: Window functions not yet supported in NQL parser
# ─────────────────────────────────────────
--- query: 17
success: false
output.contains: Error
output.contains: NQL parse error

# ─────────────────────────────────────────
# Query 18: insert into categories set name = "Accessories", slug = "accessories"
# ─────────────────────────────────────────
--- query: 18
success: true
sql.contains: insert into "ch5_ecommerce"."categories"
sql.contains: ("name", "slug") values ($1, $2)
output.contains: Rows: 1

# ─────────────────────────────────────────
# Query 19: insert into customers set firstName = "John", lastName = "Doe", email = "john@example.com"
# ─────────────────────────────────────────
--- query: 19
success: true
sql.contains: insert into "ch5_ecommerce"."customers"
sql.contains: ("first_name", "last_name", "email") values ($1, $2, $3)
output.contains: Rows: 1

# ─────────────────────────────────────────
# Query 20: update products set price = 29.99 where sku = "WIDGET-001"
# NOTE: WIDGET-001 doesn't exist in seed data, so 0 rows affected
# ─────────────────────────────────────────
--- query: 20
success: true
sql.contains: update "ch5_ecommerce"."products"
sql.contains: set "price" = $1
sql.contains: where "sku" = $2
output.contains: Rows: 0

# ─────────────────────────────────────────
# Query 21: update products set active = false where id = 5
# ─────────────────────────────────────────
--- query: 21
success: true
sql.contains: update "ch5_ecommerce"."products"
sql.contains: set "active" = $1
sql.contains: where "id" = $2
output.contains: Rows: 1

# ─────────────────────────────────────────
# Query 22: delete from orders where status = "cancelled"
# NOTE: cancelled order was deleted in previous run or doesn't exist
# ─────────────────────────────────────────
--- query: 22
success: true
sql.contains: delete from "ch5_ecommerce"."orders"
sql.contains: where "status" = $1
output.contains: Rows: 0

# ─────────────────────────────────────────
# Query 23: upsert into products on sku set name = "New Widget", sku = "WIDGET-NEW", price = 19.99, categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 23
success: true
sql.contains: insert into "ch5_ecommerce"."products"
sql.contains: on conflict ("sku") do update
output.contains: Rows: 1
