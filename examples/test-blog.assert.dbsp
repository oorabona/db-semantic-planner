# Assertions for test-blog.dbsp
# Validates output from blog schema queries

# ─────────────────────────────────────────
# Query 0: .tables
# ─────────────────────────────────────────
--- query: 0
success: true
output.contains: Tables
output.contains: authors
output.contains: posts
output.contains: comments

# ─────────────────────────────────────────
# Query 1: .schema posts
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Table: posts
output.contains: title
output.contains: published
output.contains: authorId

# ─────────────────────────────────────────
# Query 2: .relations
# ─────────────────────────────────────────
--- query: 2
success: true
output.matches: (R|r)elation

# ─────────────────────────────────────────
# Query 3: posts (simple select)
# ─────────────────────────────────────────
--- query: 3
success: true
sql.equals: select "posts".* from "posts" as "posts"
params.length: 0

# ─────────────────────────────────────────
# Query 4: authors (simple select)
# ─────────────────────────────────────────
--- query: 4
success: true
sql.equals: select "authors".* from "authors" as "authors"
params.length: 0

# ─────────────────────────────────────────
# Query 5: comments (simple select)
# ─────────────────────────────────────────
--- query: 5
success: true
sql.equals: select "comments".* from "comments" as "comments"
params.length: 0

# ─────────────────────────────────────────
# Query 6: posts where published = true
# ─────────────────────────────────────────
--- query: 6
success: true
sql.equals: select "posts".* from "posts" as "posts" where "posts"."published" = $1
params.equals: [true]

# ─────────────────────────────────────────
# Query 7: posts with author (STRAT-SIMPLIFY: json_agg default)
# FLAT-BUG-001: include JOINs now execute before SELECT expressions,
# so json_agg column appears before table.* in SELECT order.
# ─────────────────────────────────────────
--- query: 7
success: true
sql.equals: select COALESCE((SELECT json_agg(to_jsonb(__t__) ) FROM "authors" AS __t__ WHERE "__t__"."id" = "posts"."author_id"), '[]'::json) as "author_json", "posts".* from "posts" as "posts"

# ─────────────────────────────────────────
# Query 8: posts | select *, author.* | flat
# flat excludes json_agg → planner picks LATERAL (PostgreSQL)
# FLAT-BUG-001 FIXED: Single LATERAL JOIN (no duplicate LEFT JOIN)
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: select "posts".*, "author".* from "posts" as "posts" left join LATERAL ( SELECT * FROM "authors" WHERE "authors"."authorId" = "posts"."id" ) AS "author" on true

# ─────────────────────────────────────────
# Query 9: authors | select *, posts.* | flat
# flat excludes json_agg → planner picks LATERAL (PostgreSQL)
# FLAT-BUG-001 FIXED: Single LATERAL JOIN (no duplicate LEFT JOIN)
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: select "authors".*, "posts".* from "authors" as "authors" left join LATERAL ( SELECT * FROM "posts" WHERE "posts"."authorId" = "authors"."id" ) AS "posts" on true

# ─────────────────────────────────────────
# Query 10: posts select distinct *
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: select distinct "posts".* from "posts" as "posts"

# ──────────────────────────────────────────────────────────────────
# TODO: Aggregate query assertions - uncomment when NQL aggregate
# expressions are integrated with adapter-kysely compiler.
# See TODO_NQL_MIGRATION.md for tracking.
# ──────────────────────────────────────────────────────────────────

