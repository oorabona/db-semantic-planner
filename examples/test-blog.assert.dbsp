# Assertions for test-blog.dbsp
# Validates output from blog schema queries

# ─────────────────────────────────────────
# Query 0: .tables
# ─────────────────────────────────────────
--- query: 0
success: true
output.contains: Tables
output.contains: authors
output.contains: posts
output.contains: comments

# ─────────────────────────────────────────
# Query 1: .schema posts
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Table: posts
output.contains: title
output.contains: published
output.contains: authorId

# ─────────────────────────────────────────
# Query 2: .relations
# ─────────────────────────────────────────
--- query: 2
success: true
output.matches: (R|r)elation

# ─────────────────────────────────────────
# Query 3: posts (simple select)
# ─────────────────────────────────────────
--- query: 3
success: true
sql.contains: from "posts"
params.length: 0

# ─────────────────────────────────────────
# Query 4: authors (simple select)
# ─────────────────────────────────────────
--- query: 4
success: true
sql.contains: from "authors"
params.length: 0

# ─────────────────────────────────────────
# Query 5: comments (simple select)
# ─────────────────────────────────────────
--- query: 5
success: true
sql.contains: from "comments"
params.length: 0

# ─────────────────────────────────────────
# Query 6: posts where published = true
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: where
sql.contains: "published"
params.equals: [true]

# ─────────────────────────────────────────
# Query 7: posts with author
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "posts"
sql.contains: left join "authors"

# ─────────────────────────────────────────
# Query 8: posts select distinct *
# ─────────────────────────────────────────
--- query: 8
success: true
sql.matches: select\s+distinct

# ──────────────────────────────────────────────────────────────────
# TODO: Aggregate query assertions - uncomment when NQL aggregate
# expressions are integrated with adapter-kysely compiler.
# See TODO_NQL_MIGRATION.md for tracking.
# ──────────────────────────────────────────────────────────────────

