# Assertions for test-blog.dbsp
# Validates output from blog schema queries (including aggregates)

# ─────────────────────────────────────────
# Query 0: .tables
# ─────────────────────────────────────────
--- query: 0
success: true
output.contains: Tables (5)
output.contains: authors
output.contains: posts
output.contains: comments
output.contains: tags
output.contains: postTags

# ─────────────────────────────────────────
# Query 1: .schema posts
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Table: posts
output.contains: title
output.contains: slug
output.contains: published
output.contains: authorId

# ─────────────────────────────────────────
# Query 2: .relations
# ─────────────────────────────────────────
--- query: 2
success: true
output.matches: (R|r)elation

# ─────────────────────────────────────────
# Query 3: posts (simple select)
# ─────────────────────────────────────────
--- query: 3
success: true
sql.contains: from "posts"
params.length: 0

# ─────────────────────────────────────────
# Query 4: authors (simple select)
# ─────────────────────────────────────────
--- query: 4
success: true
sql.contains: from "authors"
params.length: 0

# ─────────────────────────────────────────
# Query 5: comments (simple select)
# ─────────────────────────────────────────
--- query: 5
success: true
sql.contains: from "comments"
params.length: 0

# ─────────────────────────────────────────
# Query 6: posts where published = true
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: where
sql.contains: "published"
params.equals: [true]

# ─────────────────────────────────────────
# Query 7: posts include author
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "posts"
plan.contains: include

# ─────────────────────────────────────────
# Query 8: posts select count(*)
# ─────────────────────────────────────────
--- query: 8
success: true
sql.matches: count\s*\(\s*\*\s*\)
sql.contains: from "posts"

# ─────────────────────────────────────────
# Query 9: posts select count(*) as total_posts
# ─────────────────────────────────────────
--- query: 9
success: true
sql.matches: count\s*\(\s*\*\s*\)
sql.matches: (as|AS)\s+"?total_posts"?

# ─────────────────────────────────────────
# Query 10: posts select sum(views) as total_views avg(views) as average
# NOTE: Column validation happens at DB level, not compile time
# ─────────────────────────────────────────
--- query: 10
success: true
sql.matches: sum\s*\(
sql.matches: avg\s*\(
sql.contains: "views"

# ─────────────────────────────────────────
# Query 11: posts select count(*) as post_count group by authorId
# ─────────────────────────────────────────
--- query: 11
success: true
sql.matches: count\s*\(\s*\*\s*\)
sql.matches: group\s+by
sql.contains: "authorId"

# ─────────────────────────────────────────
# Query 12: posts select min(amount) as min_order max(amount) as max_order
# NOTE: Column validation happens at DB level, not compile time
# ─────────────────────────────────────────
--- query: 12
success: true
sql.matches: min\s*\(
sql.matches: max\s*\(
sql.contains: "amount"

# ─────────────────────────────────────────
# Query 13: posts select distinct
# ─────────────────────────────────────────
--- query: 13
success: true
sql.matches: select\s+distinct

# ─────────────────────────────────────────
# Query 14: posts select count(distinct authorId) as unique_authors
# ─────────────────────────────────────────
--- query: 14
success: true
sql.matches: count\s*\(\s*distinct
sql.contains: "authorId"
