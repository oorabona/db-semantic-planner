# Assertions for scheduling.dbsp
# Validates output from scheduling schema queries (PostgreSQL Ranges)

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS ch4_scheduling CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1: !CREATE SCHEMA IF NOT EXISTS ch4_scheduling;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 2: .use ch4_scheduling
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: ch4_scheduling

# ─────────────────────────────────────────
# Query 3: .import examples/scheduling.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4: .import examples/scheduling.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5: .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (4)
output.contains: rooms
output.contains: roomBookings
output.contains: events
output.contains: priceTiers

# ─────────────────────────────────────────
# Query 6: rooms
# ─────────────────────────────────────────
--- query: 6
success: true
intent.type: query
intent.table: rooms
intent.hasWhere: false
sql.contains: from "ch4_scheduling"."rooms"
db.rows.equals: 8
db.output:
| id | name             | capacity | floor |
|----|------------------|----------|-------|
| 1  | Conference Room A | 20      | 1     |
| 2  | Conference Room B | 10      | 1     |
| 3  | Board Room       | 30       | 2     |
| 4  | Training Room    | 50       | 2     |
| 5  | Huddle Space 1   | 4        | 1     |
| 6  | Huddle Space 2   | 4        | 1     |
| 7  | Executive Suite  | 15       | 3     |
| 8  | Auditorium       | 200      | 0     |

# ─────────────────────────────────────────
# Query 7: roomBookings
# BUG FIXED: camelCase table mapping now works
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "ch4_scheduling"."room_bookings"

# ─────────────────────────────────────────
# Query 8: events
# NOTE: time_slot (tstzrange) excluded — timezone-dependent stringification
# ─────────────────────────────────────────
--- query: 8
success: true
sql.contains: from "ch4_scheduling"."events"
db.rows.equals: 10
db.output.contains: Daily Standup
db.output.contains: Sprint Planning

# ─────────────────────────────────────────
# Query 9: priceTiers
# BUG FIXED: camelCase table mapping now works
# ─────────────────────────────────────────
--- query: 9
success: true
sql.contains: from "ch4_scheduling"."price_tiers"

# ─────────────────────────────────────────
# Query 10: roomBookings | where bookingPeriod overlaps [2024-01-16,2024-01-20)
# BUG FIXED: Range operators now work
# ─────────────────────────────────────────
--- query: 10
success: true
intent.type: query
intent.table: roomBookings
intent.hasWhere: true
sql.contains: "booking_period" && $1

# ─────────────────────────────────────────
# Query 11: roomBookings | where bookingPeriod containedBy [2024-01-01,2024-02-01)
# BUG FIXED: Range operators now work
# ─────────────────────────────────────────
--- query: 11
success: true
sql.contains: "booking_period" <@ $1

# ─────────────────────────────────────────
# Query 12: priceTiers | where quantityRange contains 25
# BUG FIXED: 'contains' operator now accepts scalar values
# ─────────────────────────────────────────
--- query: 12
success: true
sql.contains: "quantity_range" @> $1

# ─────────────────────────────────────────
# Query 13: priceTiers | where productName = 'Widget A' and quantityRange contains 25
# BUG FIXED: 'contains' operator now accepts scalar values
# ─────────────────────────────────────────
--- query: 13
success: true
sql.contains: "quantity_range" @> $2

# ─────────────────────────────────────────
# Query 14: rooms | select *, roomBookings.*
# NQL v2.1: Relation path triggers include automatically
# ARCH-005: Uses json_agg subquery strategy for hasMany
# ─────────────────────────────────────────
--- query: 14
success: true
intent.type: query
intent.table: rooms
intent.with: roomBookings
intent.hasWhere: false
sql.equals: select "_rooms".*, COALESCE((SELECT json_agg(to_jsonb(__t__) ) FROM "ch4_scheduling"."room_bookings" AS __t__ WHERE "__t__"."room_id" = "_rooms"."id"), '[]'::json) as "room_bookings_json" from "ch4_scheduling"."rooms" as "_rooms"

# ─────────────────────────────────────────
# Query 15: rooms | where roomBookings.bookingPeriod overlaps [2024-01-22,2024-01-29) | select *, roomBookings.*
# NQL v2.1: Pseudo-column filter + automatic include
# ─────────────────────────────────────────
--- query: 15
success: true
intent.type: query
intent.table: rooms
intent.with: roomBookings
intent.hasWhere: true
sql.contains: "booking_period" && $1

# ─────────────────────────────────────────
# Query 16: insert into rooms set name = 'Board Room', capacity = 20, floor = 2
# ─────────────────────────────────────────
--- query: 16
success: true
sql.contains: insert into "ch4_scheduling"."rooms"
sql.contains: ("name", "capacity", "floor") values ($1, $2, $3)
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 17: insert into priceTiers set productName = 'Widget C', quantityRange = '[1,50)', unitPrice = 15.00
# ─────────────────────────────────────────
--- query: 17
success: true
intent.type: insert
intent.table: priceTiers
db.success: true
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 18: update rooms set capacity = 25 where name = 'Conference Room A'
# ─────────────────────────────────────────
--- query: 18
success: true
sql.contains: update "ch4_scheduling"."rooms"
sql.contains: set "capacity" = $1
sql.contains: where "name" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 19: update events set title = 'Team Standup (Updated)' where id = 1
# ─────────────────────────────────────────
--- query: 19
success: true
sql.contains: update "ch4_scheduling"."events"
sql.contains: set "title" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 20: delete from roomBookings where id = 99
# NOTE: Uses correct snake_case table name in SQL
# ─────────────────────────────────────────
--- query: 20
success: true
sql.contains: delete from "ch4_scheduling"."room_bookings"
sql.contains: where "id" = $1
db.rows.equals: 0

# ─────────────────────────────────────────
# Query 21: upsert into rooms on name set name = 'Meeting Room', capacity = 12
# NOTE: Compiles in dry-run, but DB rejects due to missing unique constraint on 'name'
# ─────────────────────────────────────────
--- query: 21
success: true
intent.type: upsert
intent.table: rooms
db.success: false
db.output.contains: no unique or exclusion constraint
