db.rows.equals: 0

# ─────────────────────────────────────────
# Query 14: rooms | select *, roomBookings.*
# NQL v2.1: Relation path triggers include automatically
# ARCH-005: Uses json_agg subquery strategy for hasMany
# ─────────────────────────────────────────
--- query: 14
success: true
intent.type: query
intent.table: rooms
intent.with: roomBookings
intent.hasWhere: false
sql.equals: SELECT rooms.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM ch4_scheduling.room_bookings AS __t__ WHERE __t__.room_id = rooms.id), '[]'::json) AS "roomBookings_json" FROM ch4_scheduling.rooms
db.output:
| id | name              | capacity | floor | roomBookings_json                                                                                                                                                                                                                                                                                                                                                           |
| -- | ----------------- | -------- | ----- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |
| 1  | Conference Room A | 20       | 1     | [{"id":1,"purpose":"Product planning","room_id":1,"booked_by":"Alice Johnson","booking_period":"[2024-01-15,2024-01-17)"},{"id":2,"purpose":"Client meeting","room_id":1,"booked_by":"Bob Smith","booking_period":"[2024-01-20,2024-01-21)"},{"id":3,"purpose":"Team workshop","room_id":1,"booked_by":"Carol White","booking_period":"[2024-01-25,2024-01-28)"}]            |
| 2  | Conference Room B | 10       | 1     | [{"id":4,"purpose":"Interview sessions","room_id":2,"booked_by":"David Brown","booking_period":"[2024-01-10,2024-01-12)"},{"id":5,"purpose":"Code review","room_id":2,"booked_by":"Eve Davis","booking_period":"[2024-01-18,2024-01-19)"}]                                                                                                                                   |
| 3  | Board Room        | 30       | 2     | [{"id":6,"purpose":"Board meeting","room_id":3,"booked_by":"Frank Miller","booking_period":"[2024-01-08,2024-01-09)"},{"id":7,"purpose":"Strategy session","room_id":3,"booked_by":"Grace Lee","booking_period":"[2024-01-15,2024-01-16)"},{"id":8,"purpose":"Investor presentation","room_id":3,"booked_by":"Henry Wilson","booking_period":"[2024-01-22,2024-01-24)"}]     |
| 4  | Training Room     | 50       | 2     | [{"id":9,"purpose":"New hire onboarding","room_id":4,"booked_by":"Ivy Chen","booking_period":"[2024-01-02,2024-01-05)"},{"id":10,"purpose":"Technical training","room_id":4,"booked_by":"Jack Taylor","booking_period":"[2024-01-15,2024-01-20)"},{"id":11,"purpose":"Certification prep","room_id":4,"booked_by":"Karen Adams","booking_period":"[2024-01-29,2024-02-02)"}] |
| 5  | Huddle Space 1    | 4        | 1     | []                                                                                                                                                                                                                                                                                                                                                                           |
| 6  | Huddle Space 2    | 4        | 1     | []                                                                                                                                                                                                                                                                                                                                                                           |
| 7  | Executive Suite   | 15       | 3     | [{"id":12,"purpose":"Executive reserved","room_id":7,"booked_by":"CEO Office","booking_period":"[2024-01-01,2024-01-31)"}]                                                                                                                                                                                                                                                   |
| 8  | Auditorium        | 200      | 0     | [{"id":13,"purpose":"All-hands meeting","room_id":8,"booked_by":"HR Team","booking_period":"[2024-01-10,2024-01-11)"}]                                                                                                                                                                                                                                                       |

# ─────────────────────────────────────────
# Query 15: rooms | where roomBookings.bookingPeriod overlaps [2024-01-22,2024-01-29) | select *, roomBookings.*
# NQL v2.1: Pseudo-column filter + automatic include
# ─────────────────────────────────────────
--- query: 15
success: true
intent.type: query
intent.table: rooms
intent.with: roomBookings
intent.hasWhere: true
sql.equals: SELECT rooms.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM ch4_scheduling.room_bookings AS __t__ WHERE __t__.room_id = rooms.id), '[]'::json) AS "roomBookings_json" FROM ch4_scheduling.rooms WHERE EXISTS (SELECT 1 FROM ch4_scheduling.room_bookings AS room_bookings_exists_0 WHERE rooms.id = room_bookings_exists_0.room_id AND room_bookings_exists_0.booking_period && $1)
db.success: true

# ─────────────────────────────────────────
# Query 16: insert into rooms set name = 'Board Room', capacity = 20, floor = 2
# ─────────────────────────────────────────
--- query: 16
success: true
sql.equals: INSERT INTO ch4_scheduling.rooms ( name, capacity, floor ) VALUES ( $1, $2, $3 )
db.rows.equals: 1

