# Test file for minimal schema
# These are the queries from QUICKSTART.md
# NQL v2.1 Syntax: uses pipes (|) between operators

# List all tables
.tables

# Show schema for users
.schema users

# Show schema for posts
.schema posts

# Show relations
.relations posts

# Simple queries
users
posts

# With filter
users | where id = 1
posts | where published = true

# With relation include
posts | select *, user.*
users | select *, posts.*

# Multiple conditions
posts | where published = true and userId = 1

# With limit/offset
posts | limit 10
posts | limit 10 | offset 20
