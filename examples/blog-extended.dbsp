# Chapter 3: Blog-Extended Schema
# QUICKSTART.md - Hierarchical categories, complex filters, order by, combined conditions
#
# Usage:
#   pnpm dbsp repl --schema ./examples/blog-extended.schema.ts \
#     --db postgresql://postgres:demo@localhost:5432/demo \
#     --input ./examples/blog-extended.dbsp
#
# NQL v2.1 Syntax: uses pipes (|) between operators
# MIGRATION: `with` keyword removed in v2.1, use `select *, relation.*` instead

# =============================================================================
# Setup: Create isolated schema and load data
# =============================================================================

# Drop existing schema to ensure clean state (! prefix = raw SQL in natural mode)
!DROP SCHEMA IF EXISTS ch3_blog_extended CASCADE;

# Create fresh schema
!CREATE SCHEMA IF NOT EXISTS ch3_blog_extended;

# Set schema context for subsequent operations
.use ch3_blog_extended

# Import DDL (creates tables in schema)
.import examples/blog-extended.ddl.sql

# Import seed data
.import examples/blog-extended.seed.sql

# =============================================================================
# 3.3 Explore Data
# =============================================================================
.tables
authors
categories
tags
posts
comments | limit 10

# =============================================================================
# 3.3 Hierarchical Categories (Self-Referential)
# =============================================================================
categories | where parentId is null
categories | select *, children.*
categories | where parentId is null | select *, children.*

# =============================================================================
# 3.4 Featured and Popular Posts
# =============================================================================
posts | where featured = true
posts | where viewCount > 1000
posts | where featured = true and viewCount > 1500

# =============================================================================
# 3.5 Nested Includes (NQL v2.1 simplified)
# =============================================================================
# Note: Filtered includes (where on relations) not yet supported in NQL v2.1
# Use ORM API for: include('posts', { where: { published: true } })
authors | where active = true | select *, posts.*

# =============================================================================
# 3.6 ORDER BY
# =============================================================================
posts | order by viewCount desc
posts | order by viewCount desc | limit 3

# =============================================================================
# 3.7 Mutations (NQL v2: SQL-like syntax)
# =============================================================================

# Insert a new category (categories only have id, name, parentId)
insert into categories set name = 'DevOps'

# Insert a new tag
insert into tags set name = 'kubernetes', slug = 'kubernetes'

# Update a post to be featured
update posts set featured = true where id = 1

# Update view count (use snake_case column names for mutations)
update posts set view_count = 5000 where id = 1

# Delete draft posts
delete from posts where published = false

# Upsert author - insert or update on email conflict
upsert into authors on email set name = 'Charlie Updated', email = 'charlie@blog.com', active = true
