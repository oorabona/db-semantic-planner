# Chapter 2: Blog Schema
# QUICKSTART.md - M:N relations, aggregates (count, sum, avg), group by, distinct
#
# Usage:
#   pnpm dbsp repl --schema ./examples/blog.schema.ts \
#     --db postgresql://postgres:demo@localhost:5432/demo \
#     --input ./examples/blog.dbsp
#
# NQL v2 Syntax: uses pipes (|) between operators

# =============================================================================
# Setup: Create isolated schema and load data
# =============================================================================

# Create schema (! prefix = raw SQL in natural mode)
!CREATE SCHEMA IF NOT EXISTS ch2_blog;

# Set schema context for subsequent operations
.use ch2_blog

# Import DDL (creates tables in ch2_blog schema)
.import examples/blog.ddl.sql

# Import seed data
.import examples/blog.seed.sql

# =============================================================================
# 2.3 Explore Schema
# =============================================================================
.tables
.relations posts

# =============================================================================
# 2.4 Basic Queries with Data
# =============================================================================
authors
posts
tags

# =============================================================================
# 2.5 Filtering
# =============================================================================
posts | where published = true
comments | where approved = true
comments | where approved = false

# =============================================================================
# 2.6 Includes (LEFT JOIN)
# =============================================================================
authors | with posts
posts | with comments

# =============================================================================
# 2.7 Many-to-Many Relations (Tags)
# =============================================================================
posts | with tags
postTags | group by postId | select count(*)

# =============================================================================
# 2.8 Aggregates
# =============================================================================
posts | group by authorId | select count(*)
posts | where published = true | select count(*)
comments | group by postId | select count(*)

# =============================================================================
# 2.9 DISTINCT
# =============================================================================
comments | where approved = true | select count(distinct authorName)
posts | select distinct

# =============================================================================
# 2.10 Mutations (NQL v2: SQL-like syntax)
# =============================================================================

# Insert a new author
insert into authors set name = 'David', email = 'david@blog.com'

# Insert a new tag
insert into tags set name = 'tutorial'

# Update an author's bio
update authors set bio = 'Tech writer and blogger' where id = 1

# Approve a comment
update comments set approved = true where id = 1

# Delete an unapproved comment
delete from comments where approved = false

# Upsert - insert author or update on email conflict
upsert into authors on email set name = 'Alice Updated', email = 'alice@blog.com'
