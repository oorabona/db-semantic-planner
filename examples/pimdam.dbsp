# Chapter 6: PIM/DAM Schema (Advanced)
# QUICKSTART.md - Soft deletes, complex M:N, multi-locale, advanced querying patterns
#
# Usage:
#   pnpm dbsp repl --schema ./examples/pimdam.schema.ts \
#     --db postgresql://postgres:demo@localhost:5432/demo \
#     --input ./examples/pimdam.dbsp
#
# NQL v2 Syntax: uses pipes (|) between operators

# =============================================================================
# Setup: Create isolated schema and load data
# =============================================================================

# Create schema (! prefix = raw SQL in natural mode)
!CREATE SCHEMA IF NOT EXISTS ch6_pimdam;

# Set schema context for subsequent operations
.use ch6_pimdam

# Import DDL (creates tables in schema)
.import examples/pimdam.ddl.sql

# Import seed data
.import examples/pimdam.seed.sql

# =============================================================================
# 6.3 Explore the PIM/DAM Data
# =============================================================================
.tables
categories | where active = true
products | where deletedAt is null
assets | where kind = 'image'

# =============================================================================
# 6.4 ProductImages Junction Table
# =============================================================================
productImages | where status = 'approved'
productImages | where locale = 'en' | with product
productImages | with asset

# =============================================================================
# 6.5 Advanced Filtering Patterns
# =============================================================================
products | where active = true and deletedAt is null and categoryId = 7 | with category
products | where categoryId = 6

# =============================================================================
# 6.6 Hierarchical Category Structure
# =============================================================================
categories | where parentId is null
categories | where parentId is not null | with parent

# =============================================================================
# 6.7 Mutations (NQL v2: SQL-like syntax)
# =============================================================================

# Insert a new category
insert into categories set name = "Accessories", slug = "accessories", active = true

# Insert a new asset (required: filename, sha256, mime, sizeBytes, storageKey, kind)
insert into assets set filename = "new-image.jpg", sha256 = "abc123def456", mime = "image/jpeg", sizeBytes = 12345, storageKey = "uploads/new-image.jpg", kind = "image"

# Update product status
update products set active = false where id = 5

# Soft delete a product (set deletedAt)
update products set deletedAt = "2024-12-01T00:00:00Z" where sku = "OLD-PRODUCT"

# Approve a product image
update productImages set status = "approved" where id = 1

# Delete rejected images
delete from productImages where status = "rejected"

# Upsert product - insert or update on SKU conflict (pimdam uses 'title' not 'name')
upsert into products on sku set title = "Updated Product", sku = "NEW-SKU-001", categoryId = 1, active = true
