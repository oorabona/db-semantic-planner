# Assertions for pimdam.dbsp
# Validates output from PIM/DAM schema queries

# ─────────────────────────────────────────
# Query 0: !CREATE SCHEMA IF NOT EXISTS ch6_pimdam;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1: .use ch6_pimdam
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Using schema: ch6_pimdam

# ─────────────────────────────────────────
# Query 2: .import examples/pimdam.ddl.sql
# ─────────────────────────────────────────
--- query: 2
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 3: .import examples/pimdam.seed.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4: .tables
# ─────────────────────────────────────────
--- query: 4
success: true
output.contains: Tables (5)
output.contains: categories
output.contains: products
output.contains: assets
output.contains: productImages
output.contains: variants

# ─────────────────────────────────────────
# Query 5: categories | where active = true
# ─────────────────────────────────────────
--- query: 5
success: true
sql.contains: from "ch6_pimdam"."categories"
sql.contains: where "t0"."active" = $1
params.equals: [true]
db.rows.equals: 10
db.output.contains: Electronics
db.output.contains: Clothing

# ─────────────────────────────────────────
# Query 6: products | where deletedAt is null
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: from "ch6_pimdam"."products"
sql.contains: where "t0"."deleted_at" is null
db.rows.equals: 13

# ─────────────────────────────────────────
# Query 7: assets | where kind = 'image'
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "ch6_pimdam"."assets"
sql.contains: where "t0"."kind" = $1
db.rows.equals: 18

# ─────────────────────────────────────────
# Query 8: productImages | where status = 'approved'
# ─────────────────────────────────────────
--- query: 8
success: true
sql.contains: from "ch6_pimdam"."product_images"
sql.contains: where "t0"."status" = $1
db.rows.equals: 21

# ─────────────────────────────────────────
# Query 9: productImages | where locale = 'en' | with product
# ─────────────────────────────────────────
--- query: 9
success: true
sql.contains: from "ch6_pimdam"."product_images"
sql.contains: left join "ch6_pimdam"."products"
db.rows.equals: 19

# ─────────────────────────────────────────
# Query 10: productImages | with asset
# ─────────────────────────────────────────
--- query: 10
success: true
sql.contains: from "ch6_pimdam"."product_images"
sql.contains: left join "ch6_pimdam"."assets"
db.rows.equals: 25

# ─────────────────────────────────────────
# Query 11: products | where active = true and deletedAt is null and categoryId = 7 | with category
# ─────────────────────────────────────────
--- query: 11
success: true
sql.contains: from "ch6_pimdam"."products"
sql.contains: left join "ch6_pimdam"."categories"
sql.contains: where
params.equals: [true, 7]
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 12: products | where categoryId = 6
# ─────────────────────────────────────────
--- query: 12
success: true
sql.contains: from "ch6_pimdam"."products"
sql.contains: where "t0"."category_id" = $1
params.equals: [6]
db.rows.equals: 3

# ─────────────────────────────────────────
# Query 13: categories | where parentId is null
# ─────────────────────────────────────────
--- query: 13
success: true
sql.contains: from "ch6_pimdam"."categories"
sql.contains: where "t0"."parent_id" is null
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 14: categories | where parentId is not null | with parent
# ─────────────────────────────────────────
--- query: 14
success: true
sql.contains: from "ch6_pimdam"."categories"
sql.contains: left join "ch6_pimdam"."categories" as "t1"
sql.contains: where "t0"."parent_id" is not null
db.rows.equals: 8

# ─────────────────────────────────────────
# Query 15: insert into categories set name = 'Accessories', slug = 'accessories', active = true
# ─────────────────────────────────────────
--- query: 15
success: true
sql.contains: insert into "ch6_pimdam"."categories"
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 16: insert into assets set filename, sha256, mime, sizeBytes, storageKey, kind
# ─────────────────────────────────────────
--- query: 16
success: true
sql.contains: insert into "ch6_pimdam"."assets"
sql.contains: ("filename", "sha256", "mime", "size_bytes", "storage_key", "kind") values
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 17: update products set active = false where id = 5
# ─────────────────────────────────────────
--- query: 17
success: true
sql.contains: update "ch6_pimdam"."products"
sql.contains: set "active" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 18: update products set deletedAt = '2024-12-01T00:00:00Z' where sku = 'OLD-PRODUCT'
# NOTE: Soft delete by setting deletedAt timestamp
# ─────────────────────────────────────────
--- query: 18
success: true
sql.contains: update "ch6_pimdam"."products"
sql.contains: set "deleted_at" = $1
sql.contains: where "sku" = $2
db.rows.equals: 0

# ─────────────────────────────────────────
# Query 19: update productImages set status = 'approved' where id = 1
# ─────────────────────────────────────────
--- query: 19
success: true
sql.contains: update "ch6_pimdam"."product_images"
sql.contains: set "status" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 20: delete from productImages where status = 'rejected'
# NOTE: Seed data has 1 rejected image (iPhone 15 Pro DE)
# ─────────────────────────────────────────
--- query: 20
success: true
sql.contains: delete from "ch6_pimdam"."product_images"
sql.contains: where "status" = $1
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 21: upsert into products on sku set title = 'Updated Product', sku = 'NEW-SKU-001', categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 21
success: true
sql.contains: insert into "ch6_pimdam"."products"
sql.contains: on conflict ("sku") do update
db.rows.equals: 1
