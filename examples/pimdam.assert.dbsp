--- query: 11
success: true
sql.equals: SELECT product_images.*, COALESCE((SELECT json_agg(jsonb_build_object('id', __t__.id, 'kind', __t__.kind, 'filename', __t__.filename, 'sha256', __t__.sha256, 'mime', __t__.mime, 'width', __t__.width, 'height', __t__.height, 'sizeBytes', __t__.size_bytes, 'storageKey', __t__.storage_key, 'altText', __t__.alt_text, 'expiresAt', __t__.expires_at, 'createdAt', __t__.created_at) ORDER BY __t__.id ASC NULLS LAST) FROM ch6_pimdam.assets AS __t__ WHERE __t__.id = product_images.asset_id), '[]'::json) AS asset_json FROM ch6_pimdam.product_images
