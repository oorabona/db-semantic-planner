# ─────────────────────────────────────────
# Query 10 productImages | where locale = 'en' | select *, product.*
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: select "_product_images".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch6_pimdam"."products" AS __t__ WHERE "__t__"."id" = "_product_images"."product_id"), '[]'::json) as "product_json" from "ch6_pimdam"."product_images" as "_product_images" where "_product_images"."locale" = $1
db.rows.equals: 19

# ─────────────────────────────────────────
# Query 11 productImages | select *, asset.*
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: select "_product_images".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch6_pimdam"."assets" AS __t__ WHERE "__t__"."id" = "_product_images"."asset_id"), '[]'::json) as "asset_json" from "ch6_pimdam"."product_images" as "_product_images"
db.rows.equals: 25

# ─────────────────────────────────────────
# Query 12 products | where active = true and deletedAt is null and categoryId = 7 | select *, category.*
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: select "_products".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch6_pimdam"."categories" AS __t__ WHERE "__t__"."id" = "_products"."category_id"), '[]'::json) as "category_json" from "ch6_pimdam"."products" as "_products" where (("_products"."active" = $1 and "_products"."deleted_at" is null) and "_products"."category_id" = $2)
params.equals: [true, 7]
db.rows.equals: 4

