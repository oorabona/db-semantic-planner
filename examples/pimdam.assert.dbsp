# ─────────────────────────────────────────
# Query 25 upsert into products on sku set title = 'Updated Product', sku = 'NEW-SKU-001', categoryId = 1, active = true
# ─────────────────────────────────────────
--- query: 25
success: true
sql.equals: insert into "ch6_pimdam"."products" ("title", "sku", "category_id", "active") values ($1, $2, $3, $4) on conflict ("sku") do update set "title" = $5, "sku" = $6, "category_id" = $7, "active" = $8
db.rows.equals: 1
