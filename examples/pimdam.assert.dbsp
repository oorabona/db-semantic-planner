# ─────────────────────────────────────────
# Query 10 productImages | where locale = 'en' | select *, product.*
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: SELECT product_images.*, COALESCE((SELECT json_agg(jsonb_build_object('id', __t__.id, 'sku', __t__.sku, 'title', __t__.title, 'description', __t__.description, 'categoryId', __t__.category_id, 'brand', __t__.brand, 'active', __t__.active, 'createdAt', __t__.created_at, 'updatedAt', __t__.updated_at, 'deletedAt', __t__.deleted_at) ORDER BY __t__.id ASC NULLS LAST) FROM ch6_pimdam.products AS __t__ WHERE __t__.id = product_images.product_id), '[]'::json) AS product_json FROM ch6_pimdam.product_images WHERE product_images.locale = $1
db.rows.equals: 19
