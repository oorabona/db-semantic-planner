# Assertions for pimdam.dbsp
# Validates output from PIM/DAM schema queries

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS ch6_pimdam CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1 !CREATE SCHEMA IF NOT EXISTS ch6_pimdam;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 2 .use ch6_pimdam
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: ch6_pimdam

# ─────────────────────────────────────────
# Query 3 .import examples/pimdam.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4 .import examples/pimdam.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5 .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (5)
output.contains: categories
output.contains: products
output.contains: assets
output.contains: productImages
output.contains: variants

