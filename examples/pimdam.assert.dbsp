# ─────────────────────────────────────────
# Query 12 products | where active = true and deletedAt is null and categoryId = 7 | select *, category.*
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT products.*, COALESCE((SELECT json_agg(jsonb_build_object('id', __t__.id, 'name', __t__.name, 'slug', __t__.slug, 'description', __t__.description, 'parentId', __t__.parent_id, 'position', __t__.position, 'active', __t__.active, 'createdAt', __t__.created_at) ORDER BY __t__.id ASC NULLS LAST) FROM ch6_pimdam.categories AS __t__ WHERE __t__.id = products.category_id), '[]'::json) AS category_json FROM ch6_pimdam.products WHERE products.active = $1 AND products.deleted_at IS NULL AND products.category_id = $2
params.equals: [true,7]
db.rows.equals: 4
