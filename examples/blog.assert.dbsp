# Assertions for blog.dbsp
# Validates aggregates and DISTINCT queries

# ─────────────────────────────────────────
# Query 0-3: Setup commands (CREATE, .use, .import DDL, .import seed)
# ─────────────────────────────────────────
--- query: 0
success: true

--- query: 1
success: true

--- query: 2
success: true

--- query: 3
success: true

# ─────────────────────────────────────────
# Query 20: comments | where approved = true | select count(distinct authorName)
# Count distinct aggregate with WHERE filter
# ─────────────────────────────────────────
--- query: 20
success: true
sql.equals: SELECT count(DISTINCT comments.author_name) FROM ch2_blog.comments WHERE comments.approved = $1
params.equals: [true]
db.output:
| count |
| --- |
| 6 |

# ─────────────────────────────────────────
# Query 21: posts | select distinct *
# DISTINCT with all columns
# ─────────────────────────────────────────
--- query: 21
success: true
sql.equals: SELECT DISTINCT posts.* FROM ch2_blog.posts
db.rows.equals: 6
