# ─────────────────────────────────────────
# Query 8: employees | where managerId = null | select name, title
# Top-level employees (no manager — CEO); `= null` compiles to IS NULL
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: SELECT employees.name, employees.title FROM hierarchy.employees WHERE employees.manager_id IS NULL
params.length: 0
db.output:
| name | title |
| --- | --- |
| Alice | CEO |

# ─────────────────────────────────────────
# Query 9: employees | select name, managementChain.*
# Recursive scalar CTE aggregate — one root row per employee
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: SELECT employees.name, COALESCE((WITH RECURSIVE "managementChain_walk" AS (SELECT __n.id AS id, __n.name AS name, __n.email AS email, __n.title AS title, __n.department_id AS department_id, __n.manager_id AS manager_id, __n.hire_date AS hire_date, __n.salary AS salary, 1 AS __depth, array_remove(ARRAY[employees.id, __n.id], NULL) AS __visited FROM hierarchy.employees AS __n WHERE __n.id = employees.manager_id AND __n.id IS DISTINCT FROM employees.id AND __n.id IS NOT NULL UNION ALL SELECT __n.id AS id, __n.name AS name, __n.email AS email, __n.title AS title, __n.department_id AS department_id, __n.manager_id AS manager_id, __n.hire_date AS hire_date, __n.salary AS salary, "managementChain_walk".__depth + 1 AS __depth, "managementChain_walk".__visited || __n.id AS __visited FROM "managementChain_walk" JOIN hierarchy.employees AS __n ON __n.id = "managementChain_walk".manager_id WHERE "managementChain_walk".__depth < 10 AND __n.id <> ALL ("managementChain_walk".__visited)) SELECT json_agg(json_build_object('id', "managementChain_walk".id, 'name', "managementChain_walk".name, 'email', "managementChain_walk".email, 'title', "managementChain_walk".title, 'departmentId', "managementChain_walk".department_id, 'managerId', "managementChain_walk".manager_id, 'hireDate', "managementChain_walk".hire_date, 'salary', "managementChain_walk".salary, '__dbsp_node', "managementChain_walk".id, '__dbsp_parent', "managementChain_walk".manager_id, '__dbsp_depth', "managementChain_walk".__depth, '__dbsp_order', "managementChain_walk".id) ORDER BY "managementChain_walk".__depth, "managementChain_walk".id) FROM "managementChain_walk"), '[]'::json) AS "managementChain_json" FROM hierarchy.employees
params.equals: []
db.output:
| name | managementChain_json |
| --- | --- |
| Alice | [] |
| Bob | [{"id":1,"name":"Alice","email":"alice@example.com","title":"CEO","departmentId":1,"managerId":null,"hireDate":"2020-01-15","salary":250000,"__dbsp_node":1,"__dbsp_parent":null,"__dbsp_depth":1,"__dbsp_order":1}] |
| Carol | [{"id":1,"name":"Alice","email":"alice@example.com","title":"CEO","departmentId":1,"managerId":null,"hireDate":"2020-01-15","salary":250000,"__dbsp_node":1,"__dbsp_parent":null,"__dbsp_depth":1,"__dbsp_order":1}] |
