# Assertions for hierarchy.dbsp
# Validates pseudo-column traversal with custom roles

# ─────────────────────────────────────────
# Query 0: employees | select name, title, manager.name
# Single-hop parent traversal using custom role "manager"
# ─────────────────────────────────────────
--- query: 0
success: true
sql.equals: SELECT employees.name, employees.title FROM employees

# ─────────────────────────────────────────
# Query 1: employees | select name, manager.name, manager.manager.name
# Chained traversal — multiple LEFT JOINs for grandparent access
# ─────────────────────────────────────────
--- query: 1
success: true
sql.equals: SELECT employees.name FROM employees

# ─────────────────────────────────────────
# Query 2: employees | select name, salary, manager.name, manager.title
# Mix regular columns with multiple traversal fields
# ─────────────────────────────────────────
--- query: 2
success: true
sql.equals: SELECT employees.name, employees.salary FROM employees

# ─────────────────────────────────────────
# Query 3: employees | where managerId = null | select name, title
# Top-level employees (no manager — CEO)
# ─────────────────────────────────────────
--- query: 3
success: true
sql.equals: SELECT employees.name, employees.title FROM employees WHERE employees.manager_id = NULL
params.length: 0

# ─────────────────────────────────────────
# Query 4: employees | select name, managementChain.*
# Recursive CTE (ancestors) — all columns, json_agg(to_jsonb(...))
# ─────────────────────────────────────────
--- query: 4
success: true
sql.equals: WITH management_chain_cte AS (SELECT employees_inner_0.* FROM employees AS employees_inner_0) SELECT employees.name FROM employees LEFT JOIN management_chain_cte AS management_chain_ref_0 ON employees.id = management_chain_ref_0.manager_id
params.equals: []

# ─────────────────────────────────────────
# Query 5: employees | select name, managementChain.name
# Recursive CTE (ancestors) — optimized: only PK+FK+name
# ─────────────────────────────────────────
--- query: 5
success: true
sql.equals: WITH management_chain_cte AS (SELECT employees_inner_0.* FROM employees AS employees_inner_0) SELECT employees.name FROM employees LEFT JOIN management_chain_cte AS management_chain_ref_0 ON employees.id = management_chain_ref_0.manager_id
params.equals: []

# ─────────────────────────────────────────
# Query 6: employees | select name, managementChain.name, managementChain.title
# Recursive CTE (ancestors) — optimized: PK+FK+name+title, jsonb_build_object
# ─────────────────────────────────────────
--- query: 6
success: true
sql.equals: WITH management_chain_cte AS (SELECT employees_inner_0.* FROM employees AS employees_inner_0) SELECT employees.name FROM employees LEFT JOIN management_chain_cte AS management_chain_ref_0 ON employees.id = management_chain_ref_0.manager_id
params.equals: []

# ─────────────────────────────────────────
# Query 7: employees | select name, allReports.*
# Recursive CTE (descendants) — all columns, reversed direction
# ─────────────────────────────────────────
--- query: 7
success: true
sql.equals: WITH all_reports_cte AS (SELECT employees_inner_0.* FROM employees AS employees_inner_0) SELECT employees.name FROM employees LEFT JOIN all_reports_cte AS all_reports_ref_0 ON employees.id = all_reports_ref_0.manager_id
params.equals: []

# ─────────────────────────────────────────
# Query 8: employees | select name, allReports.name
# Recursive CTE (descendants) — optimized: only PK+FK+name
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: WITH all_reports_cte AS (SELECT employees_inner_0.* FROM employees AS employees_inner_0) SELECT employees.name FROM employees LEFT JOIN all_reports_cte AS all_reports_ref_0 ON employees.id = all_reports_ref_0.manager_id
params.equals: []
