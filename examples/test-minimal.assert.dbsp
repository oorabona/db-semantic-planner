# Assertions for test-minimal.dbsp
# Validates output from minimal schema queries

# ─────────────────────────────────────────
# Query 0: .tables
# ─────────────────────────────────────────
--- query: 0
success: true
output.contains: Tables (2)
output.contains: users
output.contains: posts

# ─────────────────────────────────────────
# Query 1: .schema users
# ─────────────────────────────────────────
--- query: 1
success: true
output.contains: Table: users
output.contains: id
output.contains: name
output.contains: email

# ─────────────────────────────────────────
# Query 2: .schema posts
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Table: posts
output.contains: userId

# ─────────────────────────────────────────
# Query 3: .relations posts
# ─────────────────────────────────────────
--- query: 3
success: true
output.matches: (R|r)elation

# ─────────────────────────────────────────
# Query 4: users (simple select)
# ─────────────────────────────────────────
--- query: 4
success: true
sql.equals: SELECT users.* FROM users
params.length: 0

# ─────────────────────────────────────────
# Query 5: posts (simple select)
# ─────────────────────────────────────────
--- query: 5
success: true
sql.equals: SELECT posts.* FROM posts
params.length: 0

# ─────────────────────────────────────────
# Query 6: users where id = 1
# ─────────────────────────────────────────
--- query: 6
success: true
sql.equals: SELECT users.* FROM users WHERE users.id = $1
params.equals: [1]

# ─────────────────────────────────────────
# Query 7: posts where published = true
# NOTE: published column exists in posts schema, but the value is parameterized
# ─────────────────────────────────────────
--- query: 7
success: true
sql.equals: SELECT posts.* FROM posts WHERE posts.published = $1
params.equals: [true]

# ─────────────────────────────────────────
# Query 8: posts with user (STRAT-SIMPLIFY: json_agg default)
# "user" relation exists (auto-inferred from userId references)
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: SELECT posts.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM users AS __t__ WHERE __t__.id = posts.user_id), '[]'::json) AS user_json FROM posts

# ─────────────────────────────────────────
# Query 9: users with posts (STRAT-SIMPLIFY: json_agg default)
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: SELECT users.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM posts AS __t__ WHERE __t__.user_id = users.id), '[]'::json) AS posts_json FROM users

# ─────────────────────────────────────────
# Query 10: posts where published = true and userId = 1
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: SELECT posts.* FROM posts WHERE posts.published = $1 AND posts.user_id = $2
params.length: 2

# ─────────────────────────────────────────
# Query 11: posts limit 10
# NOTE: LIMIT value is parameterized ($1)
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: SELECT posts.* FROM posts LIMIT 10

# ─────────────────────────────────────────
# Query 12: posts limit 10 offset 20
# NOTE: LIMIT and OFFSET values are parameterized ($1, $2)
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT posts.* FROM posts LIMIT 10 OFFSET 20
