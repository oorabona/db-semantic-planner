# Assertions for test-minimal.dbsp
# Validates output from minimal schema queries

# ─────────────────────────────────────────
# Query 0-4: Setup commands (DROP, CREATE, .use, .import DDL, .import seed)
# ─────────────────────────────────────────
--- query: 0
success: true

--- query: 1
success: true

--- query: 2
success: true

--- query: 3
success: true

--- query: 4
success: true

# ─────────────────────────────────────────
# Query 5: .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (2)
output.contains: users
output.contains: posts

# ─────────────────────────────────────────
# Query 6: .schema users
# ─────────────────────────────────────────
--- query: 6
success: true
output.contains: Table: users
output.contains: id
output.contains: name
output.contains: email

# ─────────────────────────────────────────
# Query 7: .schema posts
# ─────────────────────────────────────────
--- query: 7
success: true
output.contains: Table: posts
output.contains: userId

# ─────────────────────────────────────────
# Query 8: .relations posts
# ─────────────────────────────────────────
--- query: 8
success: true
output.matches: (R|r)elation

# ─────────────────────────────────────────
# Query 9: users (simple select)
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: SELECT users.* FROM minimal.users
params.length: 0
db.output:
| id | name | email |
| --- | --- | --- |
| 1 | Alice | alice@example.com |
| 2 | Bob | bob@example.com |
| 3 | Charlie | charlie@example.com |

# ─────────────────────────────────────────
# Query 10: posts (simple select)
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: SELECT posts.* FROM minimal.posts
params.length: 0
db.output:
| id | title | content | user_id |
| --- | --- | --- |--- |
| 1 | Hello World | My first post! | 1 |
| 2 | Getting Started | Here is how to begin... | 1 |
| 3 | Tips and Tricks | Some useful tips for beginners. | 2 |
| 4 | Advanced Topics | NULL | 2 |
| 5 | Final Thoughts | Wrapping up the series. | 3 |

# ─────────────────────────────────────────
# Query 11: users where id = 1
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: SELECT users.* FROM minimal.users WHERE users.id = $1
params.equals: [1]
db.output:
| id | name | email |
| --- | --- | --- |
| 1 | Alice | alice@example.com |

# ─────────────────────────────────────────
# Query 12: posts where published = true
# NOTE: published column not in minimal DDL — dbSuccess=false
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT posts.* FROM minimal.posts WHERE posts.published = $1
params.equals: [true]

# ─────────────────────────────────────────
# Query 13: posts with user (json_agg default)
# ─────────────────────────────────────────
--- query: 13
success: true
sql.equals: SELECT posts.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM minimal.users AS __t__ WHERE __t__.id = posts.user_id), '[]'::json) AS user_json FROM minimal.posts

# ─────────────────────────────────────────
# Query 14: users with posts (json_agg default)
# ─────────────────────────────────────────
--- query: 14
success: true
sql.equals: SELECT users.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM minimal.posts AS __t__ WHERE __t__.user_id = users.id), '[]'::json) AS posts_json FROM minimal.users

# ─────────────────────────────────────────
# Query 15: posts where published = true and userId = 1
# NOTE: published column not in minimal DDL — dbSuccess=false
# ─────────────────────────────────────────
--- query: 15
success: true
sql.equals: SELECT posts.* FROM minimal.posts WHERE posts.published = $1 AND posts.user_id = $2
params.length: 2

# ─────────────────────────────────────────
# Query 16: posts limit 10
# ─────────────────────────────────────────
--- query: 16
success: true
sql.equals: SELECT posts.* FROM minimal.posts LIMIT 10
db.output:
| id | title | content | user_id |
| --- | --- | --- | --- |
| 1 | Hello World | My first post! | 1 |
| 2 | Getting Started | Here is how to begin... | 1 |
| 3 | Tips and Tricks | Some useful tips for beginners. | 2 |
| 4 | Advanced Topics | NULL | 2 |
| 5 | Final Thoughts | Wrapping up the series. | 3 |

# ─────────────────────────────────────────
# Query 17: posts limit 10 offset 20
# NOTE: offset 20 exceeds total rows (5), returns empty
# ─────────────────────────────────────────
--- query: 17
success: true
sql.equals: SELECT posts.* FROM minimal.posts LIMIT 10 OFFSET 20
db.rows.equals: 0
