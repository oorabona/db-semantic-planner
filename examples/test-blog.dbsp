# Test file for blog schema
# NQL v2 Syntax: uses pipes (|) between operators

# Basic commands
.tables
.schema posts
.relations

# Simple queries
posts
authors
comments

# Filtered queries
posts | where published = true
posts | with author

# Distinct (works with explicit columns)
posts | select distinct *

