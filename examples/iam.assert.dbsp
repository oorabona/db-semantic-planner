# Assertions for iam.dbsp
# Validates output from IAM/RBAC schema queries
# Note: E2E test runner uses namingConvention: 'camelCase' → SQL uses snake_case identifiers

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS iam_example CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: [RAW_SQL]

# ─────────────────────────────────────────
# Query 1: !CREATE SCHEMA IF NOT EXISTS iam_example;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: [RAW_SQL]

# ─────────────────────────────────────────
# Query 2: .use iam_example
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: iam_example

# ─────────────────────────────────────────
# Query 3: .import examples/iam.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4: .import examples/iam.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5: .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (9)
output.contains: users
output.contains: roles
output.contains: permissions
output.contains: resources
output.contains: userRoles
output.contains: rolePermissions
output.contains: roleEdges
output.contains: sodRules
output.contains: auditLog

# ─────────────────────────────────────────
# Query 6: .relations roles
# ─────────────────────────────────────────
--- query: 6
success: true
output.contains: Relations for roles
output.contains: roles.userRoles: hasMany
output.contains: roles.rolePermissions: hasMany
output.contains: roles.childEdges: hasMany
output.contains: roles.parentEdges: hasMany
output.contains: roles.sodRulesA: hasMany
output.contains: roles.sodRulesB: hasMany

# ─────────────────────────────────────────
# Query 7: .schema roleEdges
# ─────────────────────────────────────────
--- query: 7
success: true
output.contains: Table: roleEdges
output.contains: id: integer
output.contains: parentRoleId: integer
output.contains: childRoleId: integer

# ─────────────────────────────────────────
# Query 8: users
# ─────────────────────────────────────────
--- query: 8
success: true
sql.equals: SELECT users.* FROM iam_example.users
db.rows.equals: 6

# ─────────────────────────────────────────
# Query 9: users | where active = true
# ─────────────────────────────────────────
--- query: 9
success: true
sql.equals: SELECT users.* FROM iam_example.users WHERE users.active = $1
params.equals: [true]
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 10: roles
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: SELECT roles.* FROM iam_example.roles
db.rows.equals: 9

# ─────────────────────────────────────────
# Query 11: roles | where active = true
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: SELECT roles.* FROM iam_example.roles WHERE roles.active = $1
params.equals: [true]
db.rows.equals: 9

# ─────────────────────────────────────────
# Query 12: permissions
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT permissions.* FROM iam_example.permissions
db.rows.equals: 13

# ─────────────────────────────────────────
# Query 13: permissions | where resource = 'users'
# ─────────────────────────────────────────
--- query: 13
success: true
sql.equals: SELECT permissions.* FROM iam_example.permissions WHERE permissions.resource = $1
params.equals: ["users"]
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 14: users | select *, userRoles.*
# ─────────────────────────────────────────
--- query: 14
success: true
sql.equals: SELECT users.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.user_roles AS __t__ WHERE __t__.user_id = users.id), '[]'::json) AS "userRoles_json" FROM iam_example.users
db.rows.equals: 6

# ─────────────────────────────────────────
# Query 15: roles | select *, rolePermissions.*
# ─────────────────────────────────────────
--- query: 15
success: true
sql.equals: SELECT roles.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.role_permissions AS __t__ WHERE __t__.role_id = roles.id), '[]'::json) AS "rolePermissions_json" FROM iam_example.roles
db.rows.equals: 9

# ─────────────────────────────────────────
# Query 16: userRoles | where userId = 1
# ─────────────────────────────────────────
--- query: 16
success: true
sql.equals: SELECT user_roles.* FROM iam_example.user_roles WHERE user_roles.user_id = $1
params.equals: [1]
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 17: rolePermissions | where roleId = 2
# ─────────────────────────────────────────
--- query: 17
success: true
sql.equals: SELECT role_permissions.* FROM iam_example.role_permissions WHERE role_permissions.role_id = $1
params.equals: [2]
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 18: roleEdges
# ─────────────────────────────────────────
--- query: 18
success: true
sql.equals: SELECT role_edges.* FROM iam_example.role_edges
db.rows.equals: 7

# ─────────────────────────────────────────
# Query 19: roleEdges | select *, parentRole.*, childRole.*
# ─────────────────────────────────────────
--- query: 19
success: true
sql.equals: SELECT role_edges.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.roles AS __t__ WHERE __t__.id = role_edges.parent_role_id), '[]'::json) AS "parentRole_json", COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.roles AS __t__ WHERE __t__.id = role_edges.child_role_id), '[]'::json) AS "childRole_json" FROM iam_example.role_edges
db.rows.equals: 7

# ─────────────────────────────────────────
# Query 20: sodRules
# ─────────────────────────────────────────
--- query: 20
success: true
sql.equals: SELECT sod_rules.* FROM iam_example.sod_rules
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 21: sodRules | select *, roleA.*, roleB.*
# ─────────────────────────────────────────
--- query: 21
success: true
sql.equals: SELECT sod_rules.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.roles AS __t__ WHERE __t__.id = sod_rules.role_a_id), '[]'::json) AS "roleA_json", COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM iam_example.roles AS __t__ WHERE __t__.id = sod_rules.role_b_id), '[]'::json) AS "roleB_json" FROM iam_example.sod_rules
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 22: resources
# ─────────────────────────────────────────
--- query: 22
success: true
sql.equals: SELECT resources.* FROM iam_example.resources
db.rows.equals: 8

# ─────────────────────────────────────────
# Query 23: resources | where parentId is null
# ─────────────────────────────────────────
--- query: 23
success: true
sql.equals: SELECT resources.* FROM iam_example.resources WHERE resources.parent_id IS NULL
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 24: userRoles | group by roleId | select roleId, count(*) as userCount
# ─────────────────────────────────────────
--- query: 24
success: true
sql.equals: SELECT user_roles.role_id, count(*) AS user_count FROM iam_example.user_roles GROUP BY user_roles.role_id
db.rows.equals: 8

# ─────────────────────────────────────────
# Query 25: rolePermissions | group by roleId | select roleId, count(*) as permCount
# ─────────────────────────────────────────
--- query: 25
success: true
sql.equals: SELECT role_permissions.role_id, count(*) AS perm_count FROM iam_example.role_permissions GROUP BY role_permissions.role_id
db.rows.equals: 9

# ─────────────────────────────────────────
# Query 26: roleEdges | group by parentRoleId | select parentRoleId, count(*) as childCount
# ─────────────────────────────────────────
--- query: 26
success: true
sql.equals: SELECT role_edges.parent_role_id, count(*) AS child_count FROM iam_example.role_edges GROUP BY role_edges.parent_role_id
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 27: users | where active = true | select *, userRoles.roleId, userRoles.role.rolePermissions.permission.*
# ─────────────────────────────────────────
# Deep relation traversal (4 levels): users → userRoles → role → rolePermissions → permission
# Uses nested json_agg subqueries with depth-based aliases (__t__, __t1__, __t2__, __t3__)
--- query: 27
success: true
sql.equals: SELECT users.*, COALESCE((SELECT json_agg(to_jsonb(__t__) || jsonb_build_object('role', COALESCE((SELECT json_agg(to_jsonb(__t1__) || jsonb_build_object('rolePermissions', COALESCE((SELECT json_agg(to_jsonb(__t2__) || jsonb_build_object('permission', COALESCE((SELECT json_agg(to_jsonb(__t3__)) FROM iam_example.permissions AS __t3__ WHERE __t3__.id = __t2__.permission_id), '[]'::json))) FROM iam_example.role_permissions AS __t2__ WHERE __t2__.role_id = __t1__.id), '[]'::json))) FROM iam_example.roles AS __t1__ WHERE __t1__.id = __t__.role_id), '[]'::json))) FROM iam_example.user_roles AS __t__ WHERE __t__.user_id = users.id), '[]'::json) AS "userRoles_json" FROM iam_example.users WHERE users.active = $1
params.equals: [true]
db.rows.equals: 5

# ─────────────────────────────────────────
# Query 28: auditLog | where action = 'login' | select userId, resource, timestamp
# ─────────────────────────────────────────
# Query 28: users | where active = true | select *, userRoles.roleId, userRoles.role.rolePermissions.permission.* | flat
# ─────────────────────────────────────────
# Same as query 27 but with | flat — forces JOIN strategy instead of nested json_agg
--- query: 28
success: true
sql.equals: SELECT users.*, user_roles.*, role.id AS "role.id", role_permissions.id AS "rolePermissions.id", permission.id AS "permission.id" FROM iam_example.users LEFT JOIN iam_example.user_roles AS user_roles ON users.id = user_roles.user_id LEFT JOIN iam_example.roles AS role ON users.role_id = role.id LEFT JOIN iam_example.role_permissions AS role_permissions ON users.id = role_permissions.role_id LEFT JOIN iam_example.permissions AS permission ON users.permission_id = permission.id WHERE users.active = $1
params.equals: [true]

# ─────────────────────────────────────────
# Query 29: auditLog | where action = 'login' | select userId, resource, timestamp
# ─────────────────────────────────────────
--- query: 29
success: true
sql.equals: SELECT audit_log.user_id, audit_log.resource, audit_log."timestamp" FROM iam_example.audit_log WHERE audit_log.action = $1
params.equals: ["login"]
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 30: auditLog | where details ->> 'ip' = '10.0.0.1'
# ─────────────────────────────────────────
--- query: 30
success: true
sql.equals: SELECT audit_log.* FROM iam_example.audit_log WHERE (audit_log.details ->> $1) = $2
params.equals: ["ip","10.0.0.1"]
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 31: auditLog | where action = 'login' | select id, action, details -> 'ip' as ipJson
# ─────────────────────────────────────────
--- query: 31
success: true
sql.equals: SELECT audit_log.id, audit_log.action, audit_log.details -> $1 AS ip_json FROM iam_example.audit_log WHERE audit_log.action = $2
params.equals: ["ip","login"]
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 32: auditLog | where details @> '{"ip": "10.0.0.1"}'
# ─────────────────────────────────────────
--- query: 32
success: true
sql.equals: SELECT audit_log.* FROM iam_example.audit_log WHERE audit_log.details @> $1
params.equals: ["{\"ip\": \"10.0.0.1\"}"]
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 33: auditLog | where details ? 'ip'
# ─────────────────────────────────────────
--- query: 33
success: true
sql.equals: SELECT audit_log.* FROM iam_example.audit_log WHERE audit_log.details ? $1
params.equals: ["ip"]
db.rows.equals: 4

# ─────────────────────────────────────────
# Query 34: roles | where id in (userRoles | where userId = 1 | select roleId)
# ─────────────────────────────────────────
--- query: 34
success: true
sql.equals: SELECT roles.* FROM iam_example.roles WHERE roles.id = ANY (SELECT user_roles_subq_0.role_id FROM iam_example.user_roles AS user_roles_subq_0 WHERE user_roles_subq_0.user_id = $1) AND EXISTS (SELECT 1 FROM iam_example.user_roles AS user_roles_exists_1 WHERE roles.id = user_roles_exists_1.role_id)
params.equals: [1]
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 35: users | select *, userRoles.* | limit userRoles 2
# ─────────────────────────────────────────
--- query: 35
success: true
sql.equals: SELECT users.*, user_roles_lat_0.* FROM iam_example.users LEFT JOIN LATERAL ( SELECT user_roles_inner_0.* FROM iam_example.user_roles AS user_roles_inner_0 WHERE user_roles_inner_0.user_id = users.id LIMIT 2 ) AS user_roles_lat_0 ON true
params.equals: []
db.rows.equals: 8

# ─────────────────────────────────────────
# Query 36: users | where active = true | select id | bind activeUsers
# Bind (Named CTE) — captures result for reuse in subsequent queries
# ─────────────────────────────────────────
--- query: 36
success: true
sql.equals: SELECT users.id FROM iam_example.users WHERE users.active = $1
params.equals: [true]
db.output:
| id |
| --- |
| 1 |
| 2 |
| 3 |
| 4 |
| 5 |

# ─────────────────────────────────────────
# Query 37: users | select *, userRoles.* | limit userRoles.role 1
# Per-include LIMIT nested (dotted path)
# ─────────────────────────────────────────
--- query: 37
success: true
sql.equals: SELECT users.*, user_roles.* FROM iam_example.users LEFT JOIN iam_example.user_roles AS user_roles ON users.id = user_roles.user_id
params.equals: []
db.rows.equals: 8
