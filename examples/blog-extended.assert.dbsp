db.output.contains: foreign key constraint

# ─────────────────────────────────────────
# Query 25 upsert into authors on email set name = 'Charlie Updated', email = 'charlie@blog.com', active = true
# ─────────────────────────────────────────
--- query: 25
success: true
sql.equals: INSERT INTO ch3_blog_extended.authors ( name, email, active ) VALUES ( $1, $2, $3 ) ON CONFLICT (email) DO UPDATE SET name = excluded.name, email = excluded.email, active = excluded.active
db.rows.equals: 1
