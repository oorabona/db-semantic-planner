# ─────────────────────────────────────────
# Query 11 categories | where parentId is null
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: SELECT categories.* FROM ch3_blog_extended.categories WHERE categories.parent_id IS NULL
