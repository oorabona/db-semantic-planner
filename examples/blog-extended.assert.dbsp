|----|------------|-----------|
| 1  | Technology | NULL      |
| 4  | Lifestyle  | NULL      |

# ─────────────────────────────────────────
# Query 12 categories | select *, children.*
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: SELECT categories.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM ch3_blog_extended.categories AS __t__ WHERE __t__.parent_id = categories.id), '[]'::json) AS children_json FROM ch3_blog_extended.categories
db.rows.equals: 4
output.contains: children_json
db.output:
| id | name            | parent_id | children_json                                                                               |
|----|-----------------|-----------|---------------------------------------------------------------------------------------------|
| 1  | Technology      | NULL      | [{"id":2,"name":"Web Development","parent_id":1},{"id":3,"name":"Databases","parent_id":1}] |
| 2  | Web Development | 1         | []                                                                                          |
| 3  | Databases       | 1         | []                                                                                          |
| 4  | Lifestyle       | NULL      | []                                                                                          |

# ─────────────────────────────────────────
# Query 13 categories | where parentId is null | select *, children.*
# NOTE: children_json contains nested JSON array, db.output table not suitable
# ─────────────────────────────────────────
--- query: 13
success: true
sql.equals: SELECT categories.*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM ch3_blog_extended.categories AS __t__ WHERE __t__.parent_id = categories.id), '[]'::json) AS children_json FROM ch3_blog_extended.categories WHERE categories.parent_id IS NULL
db.rows.equals: 2
db.output.contains: Technology
db.output.contains: Lifestyle
db.output.contains: children_json
db.output:
| id | name       | parent_id | children_json                                                                               |
|----|------------|-----------|---------------------------------------------------------------------------------------------|
| 1  | Technology | NULL      | [{"id":2,"name":"Web Development","parent_id":1},{"id":3,"name":"Databases","parent_id":1}] |
| 4  | Lifestyle  | NULL      | []                                                                                          |

