# ─────────────────────────────────────────
# Query 25 upsert into authors on email set name = 'Charlie Updated', email = 'charlie@blog.com', active = true
# ─────────────────────────────────────────
--- query: 25
success: true
sql.equals: insert into "ch3_blog_extended"."authors" ("name", "email", "active") values ($1, $2, $3) on conflict ("email") do update set "name" = $4, "email" = $5, "active" = $6
