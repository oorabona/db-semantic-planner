db.output.contains: David

# ─────────────────────────────────────────
# Query 11 categories | where parentId is null
# ─────────────────────────────────────────
--- query: 11
success: true
sql.equals: select "_categories".* from "ch3_blog_extended"."categories" as "_categories" where "_categories"."parent_id" is null
db.rows.equals: 2
db.output.contains: Technology
db.output.contains: Lifestyle

# ─────────────────────────────────────────
# Query 12 categories | select *, children.*
# ─────────────────────────────────────────
--- query: 12
success: true
sql.equals: select "_categories".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch3_blog_extended"."categories" AS __t__ WHERE "__t__"."parent_id" = "_categories"."id"), '[]'::json) as "children_json" from "ch3_blog_extended"."categories" as "_categories"
sql.equals: select "_categories".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch3_blog_extended"."categories" AS __t__ WHERE "__t__"."parent_id" = "_categories"."id"), '[]'::json) as "children_json" from "ch3_blog_extended"."categories" as "_categories"
db.rows.equals: 5
output.contains: children_json

# ─────────────────────────────────────────
# Query 13 categories | where parentId is null | select *, children.*
# ─────────────────────────────────────────
--- query: 13
success: true
sql.equals: select "_categories".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch3_blog_extended"."categories" AS __t__ WHERE "__t__"."parent_id" = "_categories"."id"), '[]'::json) as "children_json" from "ch3_blog_extended"."categories" as "_categories" where "_categories"."parent_id" is null
sql.equals: select "_categories".*, COALESCE((SELECT json_agg(to_jsonb(__t__)) FROM "ch3_blog_extended"."categories" AS __t__ WHERE "__t__"."parent_id" = "_categories"."id"), '[]'::json) as "children_json" from "ch3_blog_extended"."categories" as "_categories" where "_categories"."parent_id" is null
db.rows.equals: 3
# NOTE: Due to column collision (t0.* and t1.* have same names), parent columns
# are overwritten by child columns. "Technology" (parent) becomes "Web Development" (child).
# This is a known limitation of flat JOINs - see TODO_NQL.md for fix.
db.output.contains: Web Development
db.output.contains: Databases
db.output.contains: children.name

