# ─────────────────────────────────────────
# Query 10 comments | limit 10
# ─────────────────────────────────────────
--- query: 10
success: true
sql.equals: select "_comments".* from "ch3_blog_extended"."comments" as "_comments" limit $1
sql.equals: select "_comments".* from "ch3_blog_extended"."comments" as "_comments" limit $1
params.equals: [10]
db.rows.equals: 10
