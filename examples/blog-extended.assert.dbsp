# Assertions for blog-extended.dbsp
# Validates output from blog-extended schema queries

# ─────────────────────────────────────────
# Query 0: !DROP SCHEMA IF EXISTS ch3_blog_extended CASCADE;
# ─────────────────────────────────────────
--- query: 0
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 1 !CREATE SCHEMA IF NOT EXISTS ch3_blog_extended;
# ─────────────────────────────────────────
--- query: 1
db.success: true
db.output.contains: Executed SQL

# ─────────────────────────────────────────
# Query 2 .use ch3_blog_extended
# ─────────────────────────────────────────
--- query: 2
success: true
output.contains: Using schema: ch3_blog_extended

# ─────────────────────────────────────────
# Query 3 .import examples/blog-extended.ddl.sql
# ─────────────────────────────────────────
--- query: 3
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 4 .import examples/blog-extended.seed.sql
# ─────────────────────────────────────────
--- query: 4
db.success: true
db.output.contains: Imported

# ─────────────────────────────────────────
# Query 5 .tables
# ─────────────────────────────────────────
--- query: 5
success: true
output.contains: Tables (6)
output.contains: authors
output.contains: categories
output.contains: posts
output.contains: comments
output.contains: tags
output.contains: postTags

# ─────────────────────────────────────────
# Query 6 authors
# ─────────────────────────────────────────
--- query: 6
success: true
sql.contains: from "ch3_blog_extended"."authors"
db.rows.equals: 3
db.output.contains: Alice Johnson
db.output.contains: Bob Smith
db.output.contains: Charlie Brown

# ─────────────────────────────────────────
# Query 7 categories
# ─────────────────────────────────────────
--- query: 7
success: true
sql.contains: from "ch3_blog_extended"."categories"
db.rows.equals: 4
db.output.contains: Technology
db.output.contains: Web Development
db.output.contains: Databases
db.output.contains: Lifestyle

# ─────────────────────────────────────────
# Query 8 tags
# ─────────────────────────────────────────
--- query: 8
success: true
sql.contains: from "ch3_blog_extended"."tags"
db.rows.equals: 5
db.output.contains: TypeScript
db.output.contains: PostgreSQL
db.output.contains: Tutorial

# ─────────────────────────────────────────
# Query 9 posts
# ─────────────────────────────────────────
--- query: 9
success: true
sql.contains: from "ch3_blog_extended"."posts"
db.rows.equals: 8
db.output.contains: TypeScript Fundamentals
db.output.contains: PostgreSQL Deep Dive

# ─────────────────────────────────────────
# Query 10 comments | limit 10
# ─────────────────────────────────────────
--- query: 10
success: true
sql.contains: from "ch3_blog_extended"."comments"
sql.contains: limit
params.equals: [10]
db.rows.equals: 10
db.output.contains: Great intro!
db.output.contains: David

# ─────────────────────────────────────────
# Query 11 categories | where parentId is null
# ─────────────────────────────────────────
--- query: 11
success: true
sql.contains: where "_categories"."parent_id" is null
db.rows.equals: 2
db.output.contains: Technology
db.output.contains: Lifestyle

# ─────────────────────────────────────────
# Query 12 categories | select *, children.*
# ─────────────────────────────────────────
--- query: 12
success: true
sql.contains: left join "ch3_blog_extended"."categories" as "_children"
sql.contains: on "_categories"."id" = "_children"."parent_id"
db.rows.equals: 5
output.contains: children.id
output.contains: children.name

# ─────────────────────────────────────────
# Query 13 categories | where parentId is null | select *, children.*
# ─────────────────────────────────────────
--- query: 13
success: true
sql.contains: left join
sql.contains: where "_categories"."parent_id" is null
db.rows.equals: 3
# NOTE: Due to column collision (t0.* and t1.* have same names), parent columns
# are overwritten by child columns. "Technology" (parent) becomes "Web Development" (child).
# This is a known limitation of flat JOINs - see TODO_NQL.md for fix.
db.output.contains: Web Development
db.output.contains: Databases
db.output.contains: children.name

# ─────────────────────────────────────────
# Query 14 posts | where featured = true
# ─────────────────────────────────────────
--- query: 14
success: true
sql.contains: where "_posts"."featured" = $1
params.equals: [true]
db.rows.equals: 2
db.output.contains: TypeScript Fundamentals
db.output.contains: PostgreSQL Deep Dive

# ─────────────────────────────────────────
# Query 15 posts | where viewCount > 1000
# ─────────────────────────────────────────
--- query: 15
success: true
sql.contains: where "_posts"."view_count" > $1
params.equals: [1000]
db.rows.equals: 2

# ─────────────────────────────────────────
# Query 16 posts | where featured = true and viewCount > 1500
# ─────────────────────────────────────────
--- query: 16
success: true
sql.contains: where
sql.contains: "_posts"."featured" = $1
sql.contains: "_posts"."view_count" > $2
params.equals: [true, 1500]
db.rows.equals: 1
db.output.contains: PostgreSQL Deep Dive

# ─────────────────────────────────────────
# Query 17 authors | where active = true | select *, posts.*
# NOTE: NQL v2.1 simplified - filtered includes use ORM API
# ─────────────────────────────────────────
--- query: 17
success: true
sql.contains: from "ch3_blog_extended"."authors"
sql.contains: where

# ─────────────────────────────────────────
# Query 18 posts | order by viewCount desc
# ─────────────────────────────────────────
--- query: 18
success: true
sql.contains: order by "_posts"."view_count" desc
db.rows.equals: 8

# ─────────────────────────────────────────
# Query 19 posts | order by viewCount desc | limit 3
# ─────────────────────────────────────────
--- query: 19
success: true
sql.contains: order by "_posts"."view_count" desc
sql.contains: limit
params.equals: [3]
db.rows.equals: 3
db.output.contains: PostgreSQL Deep Dive
db.output.contains: TypeScript Fundamentals
db.output.contains: Advanced TypeScript

# ─────────────────────────────────────────
# Query 20 insert into categories set name = 'DevOps'
# ─────────────────────────────────────────
--- query: 20
success: true
sql.contains: insert into "ch3_blog_extended"."categories"
sql.contains: ("name") values ($1)
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 21 insert into tags set name = 'kubernetes', slug = 'kubernetes'
# ─────────────────────────────────────────
--- query: 21
success: true
sql.contains: insert into "ch3_blog_extended"."tags"
sql.contains: ("name", "slug") values ($1, $2)
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 22 update posts set featured = true where id = 1
# ─────────────────────────────────────────
--- query: 22
success: true
sql.contains: update "ch3_blog_extended"."posts"
sql.contains: set "featured" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 23 update posts set view_count = 5000 where id = 1
# ─────────────────────────────────────────
--- query: 23
success: true
sql.contains: update "ch3_blog_extended"."posts"
sql.contains: set "view_count" = $1
sql.contains: where "id" = $2
db.rows.equals: 1

# ─────────────────────────────────────────
# Query 24 delete from posts where published = false
# EXPECTED: FK constraint violation (posts have related post_tags)
# In dry-run: SQL compiles, but execution fails due to FK constraint
# ─────────────────────────────────────────
--- query: 24
success: true
sql.contains: delete from "ch3_blog_extended"."posts"
sql.contains: where "published" = $1
db.success: false
db.output.contains: foreign key constraint

# ─────────────────────────────────────────
# Query 25 upsert into authors on email set name = 'Charlie Updated', email = 'charlie@blog.com', active = true
# ─────────────────────────────────────────
--- query: 25
success: true
sql.contains: insert into "ch3_blog_extended"."authors"
sql.contains: on conflict ("email") do update
db.rows.equals: 1
