# Dependencies
node_modules/

# Build output
dist/
dist-types/
*.tsbuildinfo
# Compiled-in-place TS artifacts. Sources are .ts; the build output goes to dist/.
# Source maps are always generated (never hand-written), so they are ignored globally.
# Compiled .js/.d.ts are ignored only where the tree is pure-TS — packages/*/src, the
# tsup config, and examples/*.schema.* — so a genuinely hand-written .js/.d.ts (e.g. a
# test fixture or example) stays visible. `pnpm clean:artifacts` removes any remaining
# compiled sibling on disk (a .js/.d.ts whose .ts exists) under the source trees,
# without ignoring or deleting hand-written files; pretest:unit/pretest:e2e run it.
*.js.map
*.d.ts.map
*.config.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/tsup.config.js
examples/*.schema.js
examples/*.schema.d.ts

# Generated files (dbsp generate)
generated/

# Generated API documentation (pnpm docs:api)
docs/api/

# Test coverage
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Temporary files
tmp/
# Test fixtures written next to a package (the loader only accepts paths under
# its canonical roots, so they cannot live in the OS temp dir).
.tmp/
temp/

# Personal config files (symlinked from home)
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc
.gitmodules

# IDE
.idea/
.vscode/

# VitePress
**/.vitepress/cache/
**/.vitepress/dist/

# AI tooling
.claude/
.claude-recovery.md
.serena/
.codex/
.superpowers/

# Process / backlog artifacts (internal, never committed)
