{
	"name": "db-semantic-planner",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"test:e2e": "vitest run --config tests/e2e/vitest.config.e2e.ts",
		"lint": "pnpm biome check .",
		"lint:fix": "pnpm biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"dbsp": "pnpm tsx packages/cli/src/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@dbsp/adapter-kysely": "workspace:*",
		"@dbsp/core": "workspace:*",
		"@dbsp/schema": "workspace:*",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"kysely": "catalog:",
		"pg": "catalog:",
		"testcontainers": "^11.11.0",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
