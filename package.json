{
	"name": "db-semantic-planner",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "pnpm -r test",
		"test:e2e": "vitest run --config tests/e2e/vitest.config.e2e.ts",
		"lint": "pnpm biome check .",
		"lint:fix": "pnpm biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"dbsp": "pnpm tsx packages/cli/src/index.ts",
		"docs:api": "typedoc",
		"gui:dev": "pnpm -C packages/gui tauri dev"
	},
	"pnpm": {
		"overrides": {
			"lodash@>=4.0.0 <4.17.23": ">=4.17.23",
			"dompurify": ">=3.3.2"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@dbsp/adapter-pgsql": "workspace:*",
		"@dbsp/core": "workspace:*",
		"@dbsp/nql": "workspace:*",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@vitest/coverage-v8": "^4.1.2",
		"monaco-editor": "^0.55.1",
		"pg": "catalog:",
		"testcontainers": "^11.13.0",
		"tsx": "catalog:",
		"typedoc": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
