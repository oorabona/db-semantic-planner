{
	"name": "@db-semantic-planner/cli",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"dbsp": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@db-semantic-planner/adapter-kysely": "workspace:*",
		"@db-semantic-planner/core": "workspace:*",
		"@db-semantic-planner/schema": "workspace:*",
		"@inkjs/ui": "catalog:",
		"commander": "catalog:",
		"ink": "catalog:",
		"ink-table": "catalog:",
		"react": "catalog:"
	},
	"peerDependencies": {
		"tsx": "^4.0.0",
		"kysely": "^0.27.0",
		"pg": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"tsx": {
			"optional": true
		},
		"kysely": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
