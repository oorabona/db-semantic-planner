{
	"name": "@dbsp/cli",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"dbsp": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./generators/schema-codegen": {
			"types": "./dist/generators/schema-codegen.d.ts",
			"import": "./dist/generators/schema-codegen.js"
		},
		"./batch": {
			"types": "./dist/repl/batch.d.ts",
			"import": "./dist/repl/batch.js"
		},
		"./schema-loader": {
			"types": "./dist/utils/schema-loader.d.ts",
			"import": "./dist/utils/schema-loader.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dbsp/adapter-kysely": "workspace:*",
		"@dbsp/core": "workspace:*",
		"@dbsp/nql": "workspace:*",
		"@inkjs/ui": "catalog:",
		"@oclif/table": "^0.5.1",
		"commander": "catalog:",
		"ink": "catalog:",
		"ink-table": "catalog:",
		"react": "catalog:"
	},
	"peerDependencies": {
		"kysely": "^0.28.0",
		"pg": "^8.16.0",
		"tsx": "^4.21.0"
	},
	"peerDependenciesMeta": {
		"tsx": {
			"optional": true
		},
		"kysely": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"tsup": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
