{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"skipLibCheck": true,

		"moduleResolution": "Bundler",
		"composite": true,
		"isolatedModules": true,
		"moduleDetection": "force",

		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["vite.config.ts"]
}
