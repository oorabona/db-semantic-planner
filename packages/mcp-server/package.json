{
	"name": "@dbsp/mcp-server",
	"version": "1.0.11",
	"private": true,
	"description": "MCP Server for db-semantic-planner - expose schema and query planning to AI tools (scaffold; tools not yet implemented — see issue 112)",
	"author": "Olivier Orabona <oorabona@users.noreply.github.com>",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"ai",
		"claude",
		"database",
		"query-planner"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/oorabona/db-semantic-planner.git",
		"directory": "packages/mcp-server"
	},
	"homepage": "https://github.com/oorabona/db-semantic-planner/tree/main/packages/mcp-server",
	"bugs": {
		"url": "https://github.com/oorabona/db-semantic-planner/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"dbsp-mcp": "./dist/index.js"
	},
	"main": "./dist/api.js",
	"types": "./dist/api.d.ts",
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./cli": {
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"dev": "tsx src/index.ts"
	},
	"dependencies": {
		"@dbsp/core": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:"
	},
	"peerDependencies": {
		"tsx": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"tsx": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"tsup": "catalog:",
		"vitest": "catalog:"
	}
}
