{
	"name": "@dbsp/nql",
	"version": "1.0.1",
	"description": "NQL (Natural Query Language) - A human and LLM-friendly query language for databases",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests",
		"lint:fix": "biome check --write src tests"
	},
	"dependencies": {
		"@dbsp/types": "workspace:^",
		"chevrotain": "catalog:"
	},
	"devDependencies": {
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"keywords": [
		"nql",
		"query-language",
		"database",
		"parser",
		"sql",
		"natural-language",
		"llm-friendly"
	],
	"author": "Olivier Orabona <oorabona@users.noreply.github.com>",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/oorabona/db-semantic-planner.git",
		"directory": "packages/nql"
	},
	"homepage": "https://github.com/oorabona/db-semantic-planner/tree/main/packages/nql",
	"bugs": {
		"url": "https://github.com/oorabona/db-semantic-planner/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
