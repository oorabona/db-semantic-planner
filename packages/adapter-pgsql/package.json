{
	"name": "@dbsp/adapter-pgsql",
	"version": "1.4.0",
	"description": "PostgreSQL adapter for db-semantic-planner — compiles query intents to optimized parameterized SQL",
	"author": "Olivier Orabona <oorabona@users.noreply.github.com>",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"postgresql",
		"postgres",
		"sql",
		"orm",
		"adapter",
		"parameterized-queries",
		"database"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/oorabona/db-semantic-planner.git",
		"directory": "packages/adapter-pgsql"
	},
	"homepage": "https://github.com/oorabona/db-semantic-planner/tree/main/packages/adapter-pgsql",
	"bugs": {
		"url": "https://github.com/oorabona/db-semantic-planner/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dbsp/core": "workspace:*",
		"@dbsp/types": "workspace:^",
		"@pgsql/types": "17.6.2",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"pgsql-deparser": "17.18.3",
		"pgsql-parser": "17.9.15",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
