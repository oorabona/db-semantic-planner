		"@pgsql/types": "17.6.2",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"pgsql-deparser": "17.17.2",
		"pgsql-parser": "17.9.11",
		"typescript": "catalog:",
		"tsup": "catalog:",
		"vitest": "catalog:"
	}
}
