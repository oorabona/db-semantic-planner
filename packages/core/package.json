{
	"name": "@dbsp/core",
	"version": "1.0.0",
	"description": "Intent-first semantic query planner for databases — declare WHAT to fetch, the planner decides HOW",
	"author": "Olivier Orabona <oorabona@users.noreply.github.com>",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"orm",
		"query-planner",
		"typescript",
		"database",
		"intent-based",
		"type-safe",
		"postgresql"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/oorabona/db-semantic-planner.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/oorabona/db-semantic-planner/tree/main/packages/core",
	"bugs": {
		"url": "https://github.com/oorabona/db-semantic-planner/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dbsp/nql": "workspace:^",
		"@dbsp/types": "workspace:^",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
